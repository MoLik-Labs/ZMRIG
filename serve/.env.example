# Copy to .env and edit, or set these on the host. Every one of them has a
# default, so an empty file is a working configuration:
#
#   set -a; . ./.env; set +a; npm start
#
# Nothing here is a secret. The release feed is read from the public GitHub API
# without a token, which is why it is cached: 60 requests an hour is the
# anonymous limit and ten minutes of cache is a tenth of it.

# Where to listen. Render sets PORT; 0.0.0.0 is required inside a container.
PORT=8080
HOST=0.0.0.0

# The built documentation. `npm run build` in site/ writes it; this process only
# reads it, and exits with status 2 if index.html is missing.
SITE_ROOT=../site/build

# owner/name, for the releases API.
GITHUB_REPO=MoLik-Labs/ZMRIG

# https://api.github.com unless you run GitHub Enterprise.
# GITHUB_API=https://api.github.com

# How long a release list is reused, in milliseconds.
RELEASES_TTL=600000

# What /download prints as copyable links. Render sets RENDER_EXTERNAL_URL for
# you; set this when the site is behind your own domain. No trailing slash.
# PUBLIC_URL=https://zmrig.example.com

# Shown in the page footer. Defaults to the version in package.json.
# ZMRIG_VERSION=6.38.0
