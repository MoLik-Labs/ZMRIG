# local tooling for the web tests (npm install --no-save jsdom)
/node_modules

# python bytecode from the site asset generators (site/tools/*.py)
__pycache__/

# proxy: generated WireGuard keys and per-rig configs (private keys)
/proxy/wg
/wg

# appliance image: build output and the scratch tree (root-only, tens of GB)
/os/out
/os/.build

# docs site: dependencies and build output (the published copy lives at the root)
/site/node_modules
/site/build
/site/.docusaurus

# fleet: runtime state and secrets. The token is an environment variable, and the
# state file is somebody's rig list - neither belongs in a repository.
/fleet/data
/fleet/.env
/fleet/node_modules
