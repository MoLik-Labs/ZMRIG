# ZMRIG fleet
# Copy to .env, fill in, and never commit the copy: `fleet/.gitignore` covers
# .env, and the tokens here are the whole security boundary of the bot.

# ---------------------------------------------------------------- the bot(s)
# Telegram: talk to @BotFather, /newbot, copy the token.
TELEGRAM_BOT_TOKEN=
# Discord: discord.com/developers/applications -> Bot -> Reset Token.
# Leave empty to run Telegram only.
DISCORD_BOT_TOKEN=

# Who may use it. Telegram ids are the numbers from @userinfobot; Discord ids
# are the snowflakes (Developer Mode -> Copy User ID). Without at least one, the
# server refuses to start - a bot nobody owns would accept commands from an
# Internet stranger.
FLEET_ADMIN_IDS=123456789
DISCORD_ADMIN_IDS=

# Where unsolicited alerts go. Empty = every admin, on every platform.
# FLEET_NOTIFY=123456789

# The dashboard at /. One password, no accounts. Empty = no web UI at all.
# At least 12 characters; it signs every session cookie.
FLEET_WEB_PASSWORD=

# ------------------------------------------------------------------- server
PORT=8080
FLEET_BIND=0.0.0.0
FLEET_PUBLIC_URL=https://zmrig-fleet.onrender.com
# A scratch cache, not the fleet's memory: what the roster and the rigs' own
# reports cannot rebuild is nothing. On Render free this is lost on every
# redeploy, restart and spin-down, and the fleet comes back identical anyway.
FLEET_STATE=/tmp/fleet.json

# The fleet, written down - this is what survives. One JSON object; see
# roster.example.json. Either paste it here (Render: Environment -> Add Variable)
# or save it as fleet/roster.json and commit it; the environment wins.
#   FLEET_ROSTER={"owner":"tg:123456789","rigs":{"ZMR-1A2B-3C4D-5E6F":{"label":"basement","wallet":"4..."}}}
FLEET_ROSTER=
# Where to read it from when FLEET_ROSTER is empty. Default: fleet/roster.json.
# FLEET_ROSTER_FILE=/app/roster.json

# --------------------------------------------------------------------- rigs
# How often rigs check in, and how long silence means offline (never less than
# three intervals).
FLEET_INTERVAL=60
FLEET_OFFLINE_AFTER=300

# Alerts: heat, and a hashrate that halved. Cooldown is per rig and per kind, so
# a hot rig does not shout every minute.
FLEET_ALERT_TEMP=85
FLEET_ALERT_HASHRATE_DROP=0.5
FLEET_ALERT_COOLDOWN=1800

FLEET_RATE_LIMIT=30
FLEET_RATE_WINDOW=60
FLEET_QUEUE_LIMIT=10
