#!/bin/sh
# zmrig-os - the control tool of the ZMRIG appliance image.
#
# Everything a rig needs lives here: the wallet wizard, the mining modes, the
# supervisor, the health check and the updater. The image itself is read-only
# (a squashfs mounted under a tmpfs overlay), so this file and the config it
# writes are the only things that decide what the machine does.
#
#   zmrig-os id                  # this machine's Device ID and enrolment code
#   zmrig-os fleet --url URL     # point it at a Telegram/Discord control plane
#   zmrig-os sync                # check in, apply what the bot queued
#   zmrig-os setup               # the wizard: wallet, pool, mode, start
#   zmrig-os setup --wallet 4... --pool host:port --mode max --start
#   zmrig-os quickstart --wallet 4... [--pool host:port] [--coin xmr] [--mode max]
#                                # setup + tune + fleet + start, in one command
#   zmrig-os mode balanced       # max | balanced | eco | light | safe
#   zmrig-os mode safe 70        # ... and keep the hottest CPU sensor at 70 C
#   zmrig-os isolate 4           # keep 4 CPUs for mining (whole cores), pin the
#                                # miner to them and move IRQs off them
#   zmrig-os hugepages           # the page size the miner reads its dataset
#                                # through, and how much of it is reserved
#   zmrig-os hugepages 1g 3      # reserve 3 x 1 GiB pages at boot (a Monero
#                                # dataset is 3, and they cannot be made later)
#   zmrig-os doctor --json       # every check, machine readable
#   zmrig-os install --disk /dev/nvme0n1   # write this image onto a disk
#   zmrig-os install             # explain the two forms (live, installed)
#   zmrig-os auto --check        # is there a newer miner or image?
#   zmrig-os auto --apply        # install it, and roll back if it will not boot
#   zmrig-os slot                # which A/B root filesystem boots next
#   zmrig-os status | logs 40 | bench 30 | doctor | autotune 8 | topology
#   zmrig-os hardware            # what this CPU is, and what it can run at
#   zmrig-os update --check | update --apply | update --iso --write /dev/sdX
#   zmrig-os persist /dev/sdb1   # keep the config on a USB stick across boots
#   zmrig-os ssh-key add         # paste an authorized_keys line
#
# Environment (used by the tests and by the boot scripts):
#   ZMRIG_OS_ROOT=/tmp/x         # pretend the image root is /tmp/x
#   ZMRIG_OS_BIN=/path/zmrig     # binary to run (default <root>/usr/local/bin/zmrig)
#   ZMRIG_OS_DRYRUN=1            # print privileged changes instead of making them
#   ZMRIG_OS_SYS=/tmp/sys        # where /sys is read from, for topology (tests)
#   ZMRIG_OS_PROC=/tmp/proc      # where /proc is read from (tests)
#   ZMRIG_OS_NO_MAIN=1           # source the file and call functions (tests)
#
# POSIX sh on purpose: the image has busybox ash, and the same script has to run
# under dash in the test suite. `local` is the one extension used, and all three
# of those shells accept it.
#
# shellcheck shell=sh disable=SC3043

set -eu

VERSION="6.48.0"
MANIFEST_URL="https://github.com/MoLik-Labs/ZMRIG/releases/latest/download"
# The rolling beta is a pre-release, and `releases/latest` never points at one:
# `CHANNEL="beta"` has to name the tag instead of following the newest stable.
MANIFEST_BETA_URL="https://github.com/MoLik-Labs/ZMRIG/releases/download/os-beta"
# A full URL wins over the derived one, so the test suite can serve a manifest
# from a file:// path and a fleet can pin an exact release.
MANIFEST_OVERRIDE="${ZMRIG_OS_MANIFEST_URL:-}"

ROOT="${ZMRIG_OS_ROOT:-}"
ETC="${ROOT}/etc/zmrig"
CONF="${ETC}/os.conf"
RUN="${ROOT}/run/zmrig"
LOG="${ROOT}/var/log/zmrig.log"
OSLOG="${ROOT}/var/log/zmrig-os.log"
PIDFILE="${RUN}/zmrig.pid"
ARGSFILE="${RUN}/args"
# The boot medium, bind-mounted by the initramfs: the boot directory of a live
# image, or the root filesystem of an installed disk. Everything that has to
# outlive a reboot lives here, because the rest of the system is a squashfs
# under a tmpfs.
MEDIA="${ROOT}/media"
STATE="${MEDIA}/zmrig"
OTA_BIN="${STATE}/bin"
DRYRUN="${ZMRIG_OS_DRYRUN:-0}"

# Image defaults. src/config.zig of the installer is not involved here: an
# appliance boots with no disk, so these are the values the wizard edits.
POOL_DEFAULT="gulf.moneroocean.stream:10001"
MODE_DEFAULT="max"
# The developer fee the image ships with: three percent of Monero time, stated
# in `zmrig-os doctor`, in the miner's own `--check` line and in doc/FEE.md. An
# operator with a hundred machines can lower it or remove it, and one who wants
# to pay more can raise it to 10 - both are one key in os.conf.
DONATE_DEFAULT="3"
# Safe mode holds this unless told otherwise. 72 C is where a laptop CPU keeps
# its turbo bins and where a desktop CPU is still well inside spec; the pause
# limit is target + 15, the hard cap target + 8.
SAFE_TEMP_DEFAULT="72"
# How often a rig with a fleet configured checks in. One minute is cheap - the
# request is a few hundred bytes and the answer is usually empty - and it is the
# difference between "I pressed restart" and "I pressed restart and waited".
FLEET_INTERVAL_DEFAULT="60"
# Where the A/B slots live on the boot medium. Both are just file names next to
# each other, which is why switching one is a 1024-byte text write.
BOOT_DIR="${MEDIA}/boot"

say()  { printf '%s\n' "$*"; }

# The image writes /etc/zmrig/version at build time; when it is there it wins, so
# the tool and the ISO it shipped on can never disagree about the release.
image_version() {
    local v=""
    [ -r "$ETC/version" ] && v=$(cat "$ETC/version" 2>/dev/null || true)
    printf '%s' "${v:-$VERSION}"
}
warn() { printf 'warning: %s\n' "$*" >&2; }
die()  { printf '%s\n' "$*" >&2; exit 1; }

is_root() { [ "$(id -u)" = "0" ]; }

# Path helper: empty ROOT means "the real filesystem", so `P /etc/x` is /etc/x.
P() { printf '%s%s' "$ROOT" "$1"; }

# ------------------------------------------------------------------ topology
# `nproc` counts SMT siblings. A sibling pair shares one core's caches and its
# execution units, so for RandomX - which walks 2 MB of dataset per hash - two
# threads on a sibling pair are not two cores, they are two threads fighting
# over the same 512 KiB of L2. Everything below asks the kernel which CPUs are
# separate cores and sizes the miner to those. On a 2-thread VM `nproc` says 2
# and the kernel says 1; on a 16-thread Ryzen the difference is 16 against 8.
SYS="${ZMRIG_OS_SYS:-/sys}"

# And where the processor's own description comes from. Same idea: the default is
# the real thing, and the test suite points it at a fixture so the verdict about
# an 8-core Ryzen can be asserted on the two cores it was written on.
PROC="${ZMRIG_OS_PROC:-/proc}"

# The first CPU of every thread group, in numeric order. A machine with no
# topology information (a very old kernel, an odd container) yields nothing and
# the callers fall back to `nproc`, which is what they did before.
primary_cpus() {
    local dir cpu group
    for dir in "$SYS"/devices/system/cpu/cpu[0-9]*; do
        [ -d "$dir" ] || continue
        cpu=${dir##*/cpu}
        group=$(cat "$dir/topology/thread_siblings_list" 2>/dev/null || true)
        [ -n "$group" ] || group="$cpu"
        printf '%s %s\n' "$cpu" "$group"
    done | sort -k2,2 -k1,1n | awk '!seen[$2]++ { print $1 }' | sort -n
}

# How many CPUs the kernel lists, which is the honest thread number: `nproc`
# answers "how many may this process run on", and in a container that is not the
# machine.
thread_count() {
    local n
    n=$(find "$SYS/devices/system/cpu" -maxdepth 1 -name 'cpu[0-9]*' 2>/dev/null | wc -l | tr -d ' ')
    [ "${n:-0}" -gt 0 ] 2>/dev/null || n=$(nproc 2>/dev/null || echo 1)
    printf '%s' "$n"
}

core_count() {
    local n
    n=$(primary_cpus | awk 'END { print NR }')
    [ "${n:-0}" -gt 0 ] 2>/dev/null || n=$(nproc 2>/dev/null || echo 1)
    printf '%s' "$n"
}

# Every physical core, including the first. Holding one core back for the kernel
# costs 1/N of the hashrate - 12% on an eight-core rig - and buys back a
# responsiveness nobody is waiting on. `tune --irq steer` sends the interrupts to
# the first core instead, which is the part that was worth having.
mining_cpus() { primary_cpus; }

# CPUs on stdin -> `0x1f`. Empty when the answer would need more than one
# 64-bit word, because a mask the kernel cannot express is worse than no mask:
# the miner would be pinned to the wrong cores.
cpu_mask() {
    local value=0 cpu
    while IFS= read -r cpu; do
        case "$cpu" in ''|*[!0-9]*) continue ;; esac
        if [ "$cpu" -ge 63 ]; then printf ''; return 0; fi
        value=$(( value | (1 << cpu) ))
    done
    [ "$value" -gt 0 ] && printf '0x%x' "$value"
    return 0
}

affinity_mask() {
    case "${AFFINITY:-auto}" in
        off) return 0 ;;
        auto) mining_cpus | cpu_mask ;;
        *) printf '%s' "${AFFINITY}" ;;
    esac
}

# What the box is, in one line, for `doctor` and for a support ticket.
topology_line() {
    local cores threads numa
    cores=$(core_count)
    threads=$(thread_count)
    numa=0
    [ -d "$SYS/devices/system/node" ] && numa=$(find "$SYS/devices/system/node" -maxdepth 1 -name 'node[0-9]*' 2>/dev/null | wc -l | tr -d ' ')
    printf '%s core(s), %s thread(s)' "$cores" "$threads"
    [ "${threads:-0}" -gt "${cores:-0}" ] 2>/dev/null && printf ', SMT on'
    [ "${numa:-0}" -gt 1 ] 2>/dev/null && printf ', %s NUMA nodes' "$numa"
    return 0
}

run() {
    if [ "$DRYRUN" = "1" ]; then
        printf 'dry-run: %s\n' "$*"
        return 0
    fi
    "$@"
}

# ---------------------------------------------------------------- config

conf_get() {
    # Read one KEY=VALUE out of os.conf without sourcing it: a config file that
    # can run shell code as root on boot is a config file that will eventually
    # run the wrong shell code.
    [ -f "$CONF" ] || { printf '%s' ""; return 0; }
    sed -n "s/^$1=\"\{0,1\}\([^\"]*\)\"\{0,1\}$/\1/p" "$CONF" | tail -1
}

conf_default() {
    local value
    value=$(conf_get "$1")

    if [ -z "$value" ]; then
        printf '%s' "$2"
    else
        printf '%s' "$value"
    fi
}

# Values from the kernel command line win over the file: a fleet is re-pointed by
# editing one GRUB line, and a rig that boots from read-only media cannot be
# edited at all.
load_conf() {
    local kc="${ETC}/kernel.conf"

    WALLET=$(conf_default WALLET "")
    POOL=$(conf_default POOL "$POOL_DEFAULT")
    WORKER=$(conf_default WORKER "$(hostname 2>/dev/null || echo rig)")
    MODE=$(conf_default MODE "$MODE_DEFAULT")
    ALGO=$(conf_default ALGO "auto")
    THREADS=$(conf_default THREADS "auto")
    DONATE=$(conf_default DONATE "$DONATE_DEFAULT")
    SAFE_TEMP=$(conf_default SAFE_TEMP "$SAFE_TEMP_DEFAULT")
    MSR=$(conf_default MSR "auto")
    API_PORT=$(conf_default API_PORT "0")
    API_HOST=$(conf_default API_HOST "127.0.0.1")
    API_TOKEN=$(conf_default API_TOKEN "")
    AUTO_REBOOT=$(conf_default AUTO_REBOOT "1")
    CHANNEL=$(conf_default CHANNEL "stable")
    AUTO_UPDATE=$(conf_default AUTO_UPDATE "1")
    AUTO_IMAGE=$(conf_default AUTO_IMAGE "0")
    # Measuring the machine once, on the rig itself, is the difference between
    # the cache heuristic and the thread count this CPU can actually hold. The
    # miner starts immediately and reloads when the measurement finishes.
    AUTO_AUTOTUNE=$(conf_default AUTO_AUTOTUNE "1")
    AUTOTUNED=$(conf_default AUTOTUNED "")
    # What the measurement actually saw, and when. A number on its own says what
    # the machine *can* do; keeping the rate next to it is what lets the rig
    # notice that it no longer does.
    MEASURED_THREADS=$(conf_default MEASURED_THREADS "")
    MEASURED_HS=$(conf_default MEASURED_HS "")
    TUNED_AT=$(conf_default TUNED_AT "")
    # The control plane. Empty means "no fleet", which is the default: nothing
    # here contacts anything until somebody names a server.
    FLEET_URL=$(conf_default FLEET_URL "")
    FLEET_INTERVAL=$(conf_default FLEET_INTERVAL "$FLEET_INTERVAL_DEFAULT")
    # An install requested from the kernel command line is not a config value:
    # it is a one-shot instruction, and the machine reboots into the result.
    INSTALL=$(conf_default INSTALL "")
    EXTRA_ARGS=$(conf_default EXTRA_ARGS "")
    # auto | off | an explicit XMRig mask. Auto is "pin to the physical cores",
    # which is what almost every machine wants and what none of them used to get.
    AFFINITY=$(conf_default AFFINITY "auto")
    # How many logical CPUs stay with the miner, as whole SMT groups. 0 is the
    # default: sharing the machine with the OS costs a few percent, and a rig
    # nobody can ssh into is worse than a rig that is 3 % slower. When it is set
    # it wins over AFFINITY: the isolated set is the mask.
    ISOLATE=$(conf_default ISOLATE "0")
    # 0 turns the reservation off entirely; empty means "decide from the
    # algorithm". The boot sets it, the config can override it.
    HUGEPAGES=$(conf_default HUGEPAGES "")
    # Gigantic pages, as a count to reserve at boot. Empty is "none", which is
    # the honest default: the pool can only be created before the machine
    # fragments, and a rig that has already been mining for a week cannot get
    # one. The miner uses it when it exists and falls back to 2 MiB pages when
    # it does not, so an empty value costs nothing but the option.
    HUGEPAGES_1G=$(conf_default HUGEPAGES_1G "")
    ISOLATED_CPUS=""
    case "$ISOLATE" in
        ''|0|*[!0-9]*) ;;
        *) ISOLATED_CPUS=$(plan_iso_cpus "$SYS" "$ISOLATE" "$(thread_count)") ;;
    esac

    if [ -f "$kc" ]; then
        local v
        v=$(_kc "$kc" WALLET);   [ -n "$v" ] && WALLET="$v"
        v=$(_kc "$kc" POOL);     [ -n "$v" ] && POOL="$v"
        v=$(_kc "$kc" WORKER);   [ -n "$v" ] && WORKER="$v"
        v=$(_kc "$kc" MODE);     [ -n "$v" ] && MODE="$v"
        v=$(_kc "$kc" AFFINITY); [ -n "$v" ] && AFFINITY="$v"
        # The `[ -z ] ||` form, not `[ -n ] &&`: these are the last statements
        # of the block, and an absent key would make load_conf return 1 under
        # `set -e` - which read as "the tool cannot read its own config".
        v=$(_kc "$kc" SAFE_TEMP); [ -z "$v" ] || SAFE_TEMP="$v"
        v=$(_kc "$kc" ALGO);      [ -z "$v" ] || ALGO="$v"
        v=$(_kc "$kc" ISOLATE);   [ -z "$v" ] || ISOLATE="$v"
        v=$(_kc "$kc" HUGEPAGES);    [ -z "$v" ] || HUGEPAGES="$v"
        v=$(_kc "$kc" HUGEPAGES_1G); [ -z "$v" ] || HUGEPAGES_1G="$v"
        v=$(_kc "$kc" FLEET);     [ -z "$v" ] || FLEET_URL="$v"
        v=$(_kc "$kc" INSTALL);   [ -z "$v" ] || INSTALL="$v"
    fi
}

_kc() {
    awk -F= -v k="$2" '$1 == k { v = substr($0, index($0, "=") + 1); gsub(/^"|"$/, "", v); out = v } END { print out }' "$1"
}

# The configuration file: one writer, because there used to be two.
#
# `save_conf` wrote the running system and `conf_to_media` wrote the copy the
# installed rig boots from, and they were two copies of the same heredoc. The
# installer's copy drifted: it never learned `ISOLATE`, `HUGEPAGES` or
# `HUGEPAGES_1G`, so a rig set up as `zmrig-os isolate 4` on the live stick and
# then installed came up mining on every core, with a log that said everything
# had gone well. A key added here now exists in both files or in neither.
conf_body() {
    cat <<EOF
WALLET="${WALLET}"
POOL="${POOL}"
WORKER="${WORKER}"
MODE="${MODE}"
ALGO="${ALGO}"
THREADS="${THREADS}"
DONATE="${DONATE}"
SAFE_TEMP="${SAFE_TEMP:-$SAFE_TEMP_DEFAULT}"
MSR="${MSR}"
API_PORT="${API_PORT}"
API_HOST="${API_HOST}"
API_TOKEN="${API_TOKEN}"
AUTO_REBOOT="${AUTO_REBOOT}"
AUTO_UPDATE="${AUTO_UPDATE:-1}"
AUTO_IMAGE="${AUTO_IMAGE:-0}"
AUTO_AUTOTUNE="${AUTO_AUTOTUNE:-1}"
AUTOTUNED="${AUTOTUNED:-}"
MEASURED_THREADS="${MEASURED_THREADS:-}"
MEASURED_HS="${MEASURED_HS:-}"
AFFINITY="${AFFINITY:-auto}"
TUNED_AT="${TUNED_AT:-}"
CHANNEL="${CHANNEL}"
ISOLATE="${ISOLATE:-0}"
HUGEPAGES="${HUGEPAGES:-}"
HUGEPAGES_1G="${HUGEPAGES_1G:-}"
EXTRA_ARGS="${EXTRA_ARGS}"
FLEET_URL="${FLEET_URL}"
FLEET_INTERVAL="${FLEET_INTERVAL:-$FLEET_INTERVAL_DEFAULT}"
EOF
}

save_conf() {
    mkdir -p "$ETC" 2>/dev/null || true
    local tmp="${CONF}.new"

    {
        cat <<EOF
# ZMRIG OS configuration. Edited by \`zmrig-os setup\` and \`zmrig-os mode\`;
# everything here survives a reboot only when a ZMRIGDATA partition is present
# (\`zmrig-os persist /dev/sdX\`), because the image itself is read-only.
EOF
        conf_body
    } > "$tmp"

    # Deliberately not wrapped in `run`: ZMRIG_OS_DRYRUN exists to preview
    # privileged system changes (mounts, dd, reboot), and writing the config is
    # the one thing the wizard is *for*.
    mv "$tmp" "$CONF"

    # On an installed rig the running filesystem is still a squashfs under a
    # tmpfs, so the copy in /etc is gone after a reboot. The boot medium is
    # writable there, and the initramfs reads this file back at boot: one write,
    # two places, and no "my wallet disappeared" support ticket.
    if is_installed && [ -w "$MEDIA" ]; then
        mkdir -p "${MEDIA}/etc/zmrig" 2>/dev/null || true
        cp "$CONF" "${MEDIA}/etc/zmrig/os.conf" 2>/dev/null ||
            warn "could not copy the config to the boot medium"
    fi
}

# ------------------------------------------------------------ the medium

# A live image cannot write to its own media; an installed one can, and says so
# with a marker the installer writes. Almost every "is this persistent?" question
# in this script is this function.
is_installed() { [ -f "${STATE}/installed" ]; }

# What the boot medium is, for the status line: the partition label of an
# installed disk, or the device node of the live stick.
media_label() {
    local dev="" label=""
    [ -r "$(P /etc/zmrig/bootdev)" ] && dev=$(cat "$(P /etc/zmrig/bootdev)" 2>/dev/null || true)
    if [ -n "$dev" ] && [ -r "/sys/class/block/$(basename "$dev")/uevent" ]; then
        label=$(sed -n 's/^DEVNAME=//p' "/sys/class/block/$(basename "$dev")/uevent" 2>/dev/null | head -1)
    fi
    [ -n "$label" ] || label="${dev:-unknown}"
    printf '%s' "$label"
}

# Which A/B root filesystem this boot came from, written by the initramfs.
boot_slot() {
    local slot=""
    [ -r "$(P /etc/zmrig/slot)" ] && slot=$(cat "$(P /etc/zmrig/slot)" 2>/dev/null || true)
    case "$slot" in a|b) printf '%s' "$slot" ;; *) printf 'a' ;; esac
}

other_slot() { case "$1" in a) printf 'b' ;; *) printf 'a' ;; esac; }

# The GRUB environment block: 1024 bytes, a header, KEY=VALUE lines, '#' padding.
# GRUB reads it with `load_env`, so the guest can change which slot boots next
# without grub-editenv, without rewriting grub.cfg, and without a writable
# filesystem GRUB itself has to understand.
# Keys are merged, not replaced: the slot and the kernel parameters this rig
# needs live in the same block, and rewriting the block to change one of them
# used to forget the other - which is how a rig boots the wrong slot after
# somebody isolates a few CPUs.
write_grubenv() { # key value
    [ -d "${BOOT_DIR}/grub" ] || return 1
    grubenv_set "${BOOT_DIR}/grub/grubenv" "$1" "$2"
}

grubenv_set() { # path key value
    local env="$1"
    # The file itself may not exist yet - a fresh install seeds an empty block -
    # but the directory has to: a write into a directory that is not there is a
    # bootloader that is not there either.
    [ -d "$(dirname "$env")" ] || return 1

    # The block is built by plan.sh, which merges the keys already in it. The
    # initramfs calls the same function: it used to have its own copy that
    # replaced the block, so an automatic rollback dropped `zmrig_extra` and the
    # rig came back without its isolated CPUs. One implementation, two callers.
    if command -v plan_grubenv_block >/dev/null 2>&1; then
        plan_grubenv_block "$2" "$3" "$env" > "${env}.new" 2>/dev/null || { rm -f "${env}.new"; return 1; }
        mv "${env}.new" "$env" 2>/dev/null || return 1
        return 0
    fi

    # A root filesystem whose plan.sh did not load: the tool still has to be able
    # to switch a slot, so the fallback writes the one key it was given. The
    # block may not exist yet (a fresh install), and awk treats a missing input
    # file as an error, so /dev/null stands in for it.
    local src="$env"
    [ -r "$env" ] || src=/dev/null
    awk -v key="$2" -v value="$3" -v total=1024 '
        BEGIN { head = "# GRUB Environment Block\n" }
        {
            if ($0 == "" || substr($0, 1, 1) == "#") next
            eq = index($0, "=")
            if (eq > 0 && substr($0, 1, eq - 1) == key) next
            body = body $0 "\n"
        }
        END {
            body = key "=" value "\n" body
            room = total - length(head) - length(body) - 1
            if (room < 0) exit 1
            pad = ""
            for (i = 0; i < room; i++) pad = pad "#"
            printf "%s%s%s\n", head, body, pad
        }' "$src" > "${env}.new" 2>/dev/null || { rm -f "${env}.new"; return 1; }
    mv "${env}.new" "$env" 2>/dev/null || return 1
}

read_grubenv() { # key
    local env="${BOOT_DIR}/grub/grubenv"
    [ -r "$env" ] || return 0
    sed -n "s/^$1=//p" "$env" 2>/dev/null | head -1
}

# Sets the next boot slot. Used by `zmrig-os slot b`, by the image updater after
# it has written a new slot, and by the rollback in the initramfs.
set_next_slot() { # slot
    write_grubenv zmrig_slot "$1" || return 1
    say "next boot: slot $1"
}

# Called by the supervisor once the miner has been up for five minutes: from
# here on the slot is known good, so the boot counter that drives the rollback
# goes back to zero.
mark_boot_ok() {
    is_installed || return 0
    printf '0 %s\n' "$(boot_slot)" > "${STATE}/state/boots" 2>/dev/null || true
}

# --------------------------------------------------------------- wallet

# Monero addresses are 95 characters (4... standard, 8... subaddress) or 106
# (integrated). Base58 as used by CryptoNote drops 0 O I l to survive being read
# off a screen, so a typo like "0" or "l" is caught before it becomes a lost
# share. Other coins in the matrix use the same alphabet with their own lengths,
# and those are not checked beyond the alphabet: claiming to validate them would
# be a lie the first time a Wownero address changed length.
# The shape check below is the second line of defence, not the first: the miner
# decodes the address and verifies its Keccak checksum, and that is what catches
# the typo the alphabet check cannot see. Asking the binary costs a millisecond
# and refuses the one mistake that silently costs somebody a week of hashing, so
# it is tried first and the shell check is the fallback for a rig whose binary is
# not there yet (a first boot, or an ISO being prepared).
validate_wallet() {
    local wallet="$1" algo="$2" len bin
    len=${#wallet}
    # Whether the checksum was actually decoded, as opposed to the shape being
    # counted. `doctor` prints the difference instead of claiming a verification
    # that did not happen.
    WALLET_DECODED=0

    [ "$len" -ge 90 ] || return 1
    case "$wallet" in
        *[0OIl]*|*[!1-9A-HJ-NP-Za-km-z]*) return 1 ;;
    esac

    case "$algo" in
        auto|rx/0|randomx|xmr|monero|"")
            case "$len" in
                95|106) ;;
                *) return 1 ;;
            esac
            case "$wallet" in 4*|8*) ;; *) return 1 ;; esac

            bin=$(zmrig_bin 2>/dev/null || true)
            if [ -n "$bin" ] && [ -x "$bin" ]; then
                "$bin" --check-wallet "$wallet" >/dev/null 2>&1 || return 1
                WALLET_DECODED=1
            fi
            return 0 ;;
        *) return 0 ;;
    esac
}

# The same check with the reason, for anything that wants to say what is wrong
# rather than only refusing. Prints one line; returns 1 when the address is bad.
explain_wallet() {
    local wallet="$1" bin
    bin=$(zmrig_bin 2>/dev/null || true)
    if [ -n "$bin" ] && [ -x "$bin" ]; then
        "$bin" --check-wallet "$wallet" 2>/dev/null | sed -n '2p' | sed 's/^  //' && return 0
    fi
    validate_wallet "$wallet" auto
}

# ------------------------------------------------------------------ modes

# What each mode means, in one place, because the docs quote this table:
#
#   max       every core the cache heuristic allows, high priority, MSR when the
#             hardware allows it, full huge pages. The default.
#   balanced  leaves one core for ssh and the log tail. On 2 cores that is not
#             worth it, so it falls back to max until there are 4.
#   eco       half the cores, watt profile: less power, less heat, most of the
#             hashrate per watt.
#   light     256 MiB cache mode, for boxes without 2.5 GiB of free RAM.
#   safe      for a machine somebody also needs tomorrow: one core left for the
#             OS and the fan control, low priority, MSR untouched, and the
#             thermal governor armed at SAFE_TEMP. It gives up a few percent of
#             hashrate to keep every degree it can off the silicon; on a box
#             with poor cooling it ends up *faster* than max, because max spends
#             the hot hours hardware-throttled at a worse rate.
mode_threads() {
    local cores="$1"
    case "$MODE" in
        max)      printf '%s' "" ;;
        balanced) if [ "$cores" -ge 4 ]; then printf '%s' "$((cores - 1))"; else printf '%s' ""; fi ;;
        eco)      printf '%s' "$(( cores / 2 > 0 ? cores / 2 : 1 ))" ;;
        safe)     if [ "$cores" -ge 4 ]; then printf '%s' "$((cores - 1))"; else printf '%s' ""; fi ;;
        light)    printf '%s' "" ;;
        *)        printf '%s' "" ;;
    esac
}

mode_priority() {
    case "$MODE" in
        max)      printf '%s' "5" ;;
        balanced) printf '%s' "3" ;;
        eco)      printf '%s' "1" ;;
        # Raw nice 19, lower than any XMRig priority value: the oven's fan
        # controller, an ssh session and the desktop all win against mining.
        # `--priority` takes a raw nice value for exactly this.
        safe)     printf '%s' "19" ;;
        *)        printf '%s' "2" ;;
    esac
}

is_virtual() {
    local product=""
    [ -r /sys/class/dmi/id/product_name ] && product=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
    case "$product" in
        *KVM*|*VirtualBox*|*VMware*|*QEMU*|*"Virtual Machine"*|*Bochs*|*Xen*|*Google*|*Amazon*|*Microsoft*|*Hetzner*|*OpenStack*) return 0 ;;
    esac
    return 1
}

msr_usable() {
    is_root || return 1
    is_virtual && return 1
    [ -e /dev/cpu/0/msr ] || return 1
    return 0
}

# ------------------------------------------------------------------ CPU set
#
# iso_list is the isolated set as the kernel writes it ("4-7"), which is also
# what smp_affinity_list and isolcpus= both accept.
iso_list() {
    [ -n "${ISOLATED_CPUS:-}" ] || return 0
    # shellcheck disable=SC2086
    plan_join_list $ISOLATED_CPUS
}

housekeeping_list() {
    local total cpus
    total=$(thread_count)
    # The mask is a list by design ("4-7"), and plan_housekeeping splits it.
    cpus=$(plan_housekeeping "$total" ${ISOLATED_CPUS:-} 2>/dev/null || true)
    # shellcheck disable=SC2086
    plan_join_list $cpus
}

# Move every IRQ that can be moved off the isolated CPUs.
#
# A network interrupt landing on a core the miner is using is a context switch
# in the middle of a hash, and the kernel will keep doing it: IRQ affinity is
# inherited from whatever the driver chose at probe time. Only the movable
# interrupts are touched - the per-CPU ones (timer, local APIC) refuse the
# write, and a driver that pins its own queues keeps them.
steer_irqs() {
    local house file moved=0
    house=$(housekeeping_list)
    [ -n "$house" ] || return 0
    for file in /proc/irq/*/smp_affinity_list; do
        [ -w "$file" ] || continue
        printf '%s\n' "$house" > "$file" 2>/dev/null && moved=$((moved + 1))
    done
    log_os "IRQs: ${moved} moved, now allowed on CPU ${house} (mining on $(iso_list))"
}

# The kernel side of isolation cannot be changed after boot: isolcpus, nohz_full
# and rcu_nocbs are parsed before the scheduler exists. An installed rig carries
# a GRUB environment block the initramfs already writes to, so the parameters go
# there and take effect on the next boot - one mechanism, no grub.cfg editing.
# One writer for the whole block, because `zmrig_extra` is a single value:
# isolating CPUs after reserving gigantic pages used to overwrite the
# reservation, which is exactly the silent loss this file was already fixed for
# once (see doc/ARCHITECTURE.md on plan_grubenv_block).
# The kernel parameters this rig needs, as one string.
#
# Pure and separate from writing it, because there are two places to write: the
# running system's block (`write_boot_params`) and the block on a disk being
# installed. Installing used to seed an empty one, so a live stick configured as
# `zmrig-os isolate 4` produced an installed rig that ignored the isolation and
# reported nothing about it.
boot_params_value() {
    local cpus extra=""
    cpus=$(iso_list)
    if [ -n "$cpus" ]; then
        extra="isolcpus=${cpus} nohz_full=${cpus} rcu_nocbs=${cpus}"
    fi
    case "${HUGEPAGES_1G:-}" in
        ''|0|*[!0-9]*) ;;
        *)
            # default_hugepagesz is what makes 1 GiB the default for the pool
            # that follows; hugepages= then counts pages of that size.
            extra="${extra:+$extra }default_hugepagesz=1G hugepagesz=1G hugepages=${HUGEPAGES_1G}"
            ;;
    esac
    printf '%s' "$extra"
}

write_boot_params() {
    local extra
    extra=$(boot_params_value)
    write_grubenv zmrig_extra "$extra" || return 1
    say "next boot: ${extra:-no kernel parameters set}"
}

# The flags handed to the miner. Printed by `zmrig-os args` so the exact command
# line can be copied into a bug report, and written to run/zmrig/args so the
# supervisor and the doctor never disagree about it.
build_args() {
    local cores threads prio args="" iso_cores mask

    # Physical cores, not threads: `balanced` on a 16-thread Ryzen used to ask
    # for 15 mining threads on 8 cores, which is the fastest way to make a
    # RandomX rig slower and hotter at the same time.
    cores=$(core_count)
    # Isolation takes CPUs away from the miner, so it takes cores away too: a
    # `balanced` rig that pins seven threads on a machine where the kernel only
    # lets the miner run on three cores is a rig with two threads per scratchpad
    # and a cache that thrashes. The mode is computed over the cores the miner
    # may actually use.
    if [ -n "${ISOLATED_CPUS:-}" ]; then
        iso_cores=$(plan_iso_groups "$SYS" $ISOLATED_CPUS)
        [ "${iso_cores:-0}" -gt 0 ] && cores="$iso_cores"
    fi
    threads="$THREADS"
    if [ "$threads" = "auto" ]; then
        threads=$(mode_threads "$cores")
        # max and light leave the count to the miner, which is right on an open
        # machine and wrong under a mask: with isolation there is a hard ceiling,
        # so fill it exactly instead of hoping the miner reads the same hint.
        if [ -z "$threads" ] && [ -n "${ISOLATED_CPUS:-}" ]; then threads="$cores"; fi
    fi
    prio=$(mode_priority)

    [ -n "$WALLET" ] || die "no wallet configured: run 'zmrig-os setup'"

    args="-o $POOL -u $WALLET -p ${WORKER:-x} --donate-level ${DONATE:-$DONATE_DEFAULT}"
    [ -n "$threads" ] && args="$args -t $threads"
    [ "$ALGO" != "auto" ] && args="$args -a $ALGO"

    case "$MODE" in
        light) args="$args --mode light" ;;
        eco)   args="$args --profile watt" ;;
        safe)  args="$args --profile watt --max-temp ${SAFE_TEMP:-$SAFE_TEMP_DEFAULT}" ;;
        *)     args="$args --profile free" ;;
    esac

    args="$args --priority $prio --health-restart 900 --print-time 60 --log-file $LOG"
    [ -t 1 ] || args="$args --no-color"
    if [ "${API_PORT:-0}" != "0" ]; then
        args="$args --http-port $API_PORT --http-host $API_HOST"
        [ -n "${API_TOKEN:-}" ] && args="$args --http-access-token $API_TOKEN"
    fi

    # The MSR preset (prefetchers off) is worth 5-15 % on bare metal and nothing
    # in a VM. Three settings, and `auto` is the default:
    #
    #   on     ask for it; a machine that cannot take it logs one warning
    #   off    never, for a host where /dev/cpu must not be opened at all
    #   auto   say nothing and let the miner's own probe decide: it knows
    #          whether this CPU *has* a preset as well as whether the device
    #          answers, which is more than `msr_usable` can tell from a path.
    #
    # `safe` never writes a hardware register in any of the three: a mode whose
    # job is "leave the machine as you found it" cannot change CPU behaviour
    # behind a thermal governor that measures the result.
    case "$MSR" in
        on)  [ "$MODE" = "safe" ] && args="$args --no-msr" || args="$args --msr" ;;
        off) args="$args --no-msr" ;;
        auto) [ "$MODE" = "safe" ] && args="$args --no-msr" || : ;;
    esac

    # Pinning also protects the thread count chosen above: without it the
    # scheduler is free to put two of those threads on one core's sibling pair
    # the moment a housekeeping task wakes up. Under isolation the mask is the
    # isolated set, because that is the whole point of isolating it; above 64
    # CPUs no 64-bit mask can describe the set, so nothing is pinned rather than
    # pinning the wrong cores.
    if [ -n "${ISOLATED_CPUS:-}" ]; then
        mask=$(plan_mask_hex $ISOLATED_CPUS)
        [ -n "$mask" ] && args="$args --cpu-affinity 0x$mask"
    else
        mask=$(affinity_mask)
        [ -n "$mask" ] && args="$args --cpu-affinity $mask"
    fi

    [ -n "$EXTRA_ARGS" ] && args="$args $EXTRA_ARGS"

    printf '%s' "$args"
}

# ------------------------------------------------------------------- run

zmrig_bin() {
    if [ -n "${ZMRIG_OS_BIN:-}" ]; then
        printf '%s' "$ZMRIG_OS_BIN"
        return 0
    fi

    # An updated miner lives on the boot medium, because the image itself is a
    # read-only squashfs: installing it into /usr/local/bin would last until the
    # next reboot, which is not an update, it is a demo. `current` is a symlink
    # the updater moves atomically, so a crash mid-update leaves the old binary.
    if [ -x "${OTA_BIN}/current" ]; then
        printf '%s' "${OTA_BIN}/current"
        return 0
    fi

    printf '%s' "$(P /usr/local/bin/zmrig)"
}

running() {
    [ -f "$PIDFILE" ] || return 1
    local pid
    pid=$(cat "$PIDFILE" 2>/dev/null || echo "")
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

# Should the supervisor measure this machine before trusting the heuristic?
# Three separate reasons to say no, and each of them is a supported state:
# the operator turned it off, a measurement already picked a number, or the
# number was chosen by hand. Kept as a function so the test can assert all
# eight combinations without a miner, a run loop or a clock.
autotune_due() { # threads, autotuned, enabled
    [ "${3:-1}" = "1" ] || return 1
    [ -n "${2:-}" ] && return 1
    [ "${1:-auto}" = "auto" ] || return 1
    return 0
}

# Is the miner running well under the rate this same machine measured? Kept as a
# pure function of numbers so the test can assert every branch without a miner,
# a clock or a run loop.
#
# The reading is the 15-minute rate from the miner's own log, not the 10-second
# one: a fresh dataset build, a pool reconnect and a share burst all move the
# short window, and a measurement taken over that noise costs more hashrate than
# the drift it was chasing. Below the floor the difference between two runs of
# the same machine is in the tens of percent, so small rigs are left alone; and
# a re-measure is allowed at most once per gap, because the usual answer is
# "the machine is fine" and the measurement itself runs at the wrong count.
DRIFT_FLOOR=250
DRIFT_MIN_PCT=75
DRIFT_GAP=21600

drift_due() { # rate, measured, tuned_at, now, [floor], [min_pct], [gap]
    local rate="${1:-}" measured="${2:-}" tuned="${3:-}" now="${4:-}"
    local floor="${5:-$DRIFT_FLOOR}" pct="${6:-$DRIFT_MIN_PCT}" gap="${7:-$DRIFT_GAP}"

    case "$rate" in ''|*[!0-9]*) return 1 ;; esac
    case "$measured" in ''|*[!0-9]*) return 1 ;; esac
    case "$tuned" in ''|*[!0-9]*) return 1 ;; esac
    case "$now" in ''|*[!0-9]*) return 1 ;; esac

    [ "$measured" -ge "$floor" ] || return 1
    [ "$rate" -gt 0 ] || return 1
    [ "$((now - tuned))" -ge "$gap" ] || return 1
    [ "$((rate * 100))" -lt "$((measured * pct))" ] || return 1
    return 0
}

# "901.500" + "H/s" -> "901", "1.234" + "kH/s" -> "1234". The miner reports the
# size of the unit it printed, so the tool never has to guess which one it got.
to_hs() { # value, unit
    local value="${1:-}" unit="${2:-H/s}" whole frac="" c digits=0 i=0
    case "$value" in ''|*[!0-9.]*) return 1 ;; esac
    whole="${value%%.*}"
    case "$value" in *.*) frac="${value#*.}" ;; esac
    [ -n "$whole" ] || whole=0
    case "$unit" in
        H/s)  digits=0 ;;
        kH/s) digits=3 ;;
        MH/s) digits=6 ;;
        GH/s) digits=9 ;;
        TH/s) digits=12 ;;
        *)    return 1 ;;
    esac
    # No substring expansion in POSIX sh, so the decimals are taken one at a
    # time; this runs once per measurement, not per share.
    while [ "$i" -lt "$digits" ]; do
        c=$(printf '%s' "$frac" | cut -c "$((i + 1))")
        [ -n "$c" ] || c=0
        whole="${whole}${c}"
        i=$((i + 1))
    done
    # 0.5 MH/s arrives as "0.5": six decimals are owed, and they are zeros.
    while [ "${#whole}" -gt 1 ] && [ "${whole#0}" != "$whole" ]; do whole="${whole#0}"; done
    case "$whole" in ''|*[!0-9]*) return 1 ;; esac
    printf '%s' "$whole"
}

# Ask the supervisor to start the miner again with whatever is in the config
# now. It must not be `zmrig-os restart`: that starts a *second* supervisor
# around the miner the first one is still waiting for.
signal_reload() {
    [ -d "$RUN" ] || return 0
    : > "$RUN/reload" 2>/dev/null || true
    if running; then
        kill "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null || true
    fi
    return 0
}

log_os() {
    mkdir -p "$(dirname "$OSLOG")" 2>/dev/null || true
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$OSLOG" 2>/dev/null || true
    printf '%s\n' "$*"
}

rotate_logs() {
    for f in "$LOG" "$OSLOG"; do
        [ -f "$f" ] || continue
        local size
        size=$(wc -c < "$f" 2>/dev/null || echo 0)
        if [ "$size" -gt 8388608 ]; then
            run mv "$f" "$f.1"
        fi
    done
}

# A watcher, not a scheduler: it exists so a machine that was measured once does
# not spend the next two years quietly below its own number. Dust in a heat sink,
# a stick of RAM that started erroring, a background job somebody left running --
# none of them announce themselves, and all of them show up the same way, as a
# 15-minute rate well under what this box measured on the day it was tuned.
#
# One per supervisor: it holds the supervisor's pid and exits with it, so a
# restart of the service cannot leave a second watcher behind.
watch_drift() {
    local supervisor="$1" rate

    while kill -0 "$supervisor" 2>/dev/null; do
        sleep "${DRIFT_EVERY:-900}"
        kill -0 "$supervisor" 2>/dev/null || break

        load_conf
        [ "${AUTO_AUTOTUNE:-1}" = "1" ] || continue
        [ "$AUTOTUNED" = "1" ] || continue

        # A count somebody typed is that person's decision, in every mode: the
        # measurement may only revisit a count it chose itself.
        [ "$THREADS" = "$MEASURED_THREADS" ] || continue
        [ -n "$MEASURED_HS" ] || continue

        rate=$(last_rate)
        case "$rate" in ''|*[!0-9]*) continue ;; esac
        rate="${rate%%.*}"

        if drift_due "$rate" "$MEASURED_HS" "${TUNED_AT:-0}" "$(date +%s)"; then
            log_os "hashrate ${rate} H/s is below the ${MEASURED_HS} H/s this machine measured; measuring again"
            "$0" autotune --auto --retune >>"$OSLOG" 2>&1 || true
        fi
    done
}

drift_watching() {
    [ -f "$RUN/drift.pid" ] || return 1
    local pid
    pid=$(cat "$RUN/drift.pid" 2>/dev/null || echo "")
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

supervise() {
    local bin args rc fails=0 started autotuned_this_boot=0
    bin=$(zmrig_bin)
    [ -x "$bin" ] || die "miner binary not found: $bin"

    mkdir -p "$RUN" "$(dirname "$LOG")" 2>/dev/null || true

    # Two places, because the initramfs cannot know whether /run survived: it
    # writes /etc/zmrig/nostart, which the overlay keeps for this boot, and
    # /run/zmrig/nostart for anything that looks there. Missing the flag means
    # mining when somebody asked for a rig that does not mine.
    if [ -e "$ROOT/etc/zmrig/nostart" ] || [ -e "$RUN/nostart" ]; then
        log_os "not starting: zmrig.os.nostart=1 was on the kernel command line"
        return 0
    fi

    # Once per supervisor, not per miner start: moving a few hundred IRQ masks
    # takes a moment, and the answer does not change while the service is up.
    if [ -n "${ISOLATED_CPUS:-}" ] && is_root; then
        steer_irqs || true
    fi

    # Armed once, before the first miner starts, so the first reading it can act
    # on is the one after the measurement itself completed. Its output goes to
    # the log and its stdin to nowhere: a watcher that inherits the caller's
    # stdout keeps `zmrig-os run` from returning to whoever started it.
    if [ "${AUTO_AUTOTUNE:-1}" = "1" ] && ! drift_watching; then
        watch_drift "$$" </dev/null >>"$OSLOG" 2>&1 &
        printf '%s\n' "$!" > "$RUN/drift.pid"
    fi

    while :; do
        # Re-read the config on every restart: the wizard writes it while this
        # loop is already running, and a fleet may rewrite it over ssh. Waiting
        # for a wallet instead of exiting is what makes a headless first boot
        # possible -- the service stays up until somebody configures it.
        load_conf
        if [ -z "$WALLET" ]; then
            log_os "no wallet configured; waiting 30 s (zmrig-os setup, or zmrig.os.wallet= on the cmdline)"
            sleep 30
            continue
        fi

        # Measure the machine once, while it is already mining: a rig that waits
        # 40 s for a benchmark before the first share is a rig somebody thinks is
        # broken. The measurement saves its answer and asks for a reload.
        if [ "$autotuned_this_boot" = "0" ] && autotune_due "$THREADS" "$AUTOTUNED" "$AUTO_AUTOTUNE"; then
            autotuned_this_boot=1
            log_os "measuring the machine in ${AUTOTUNE_AFTER:-90}s; the miner keeps running meanwhile"
            ( sleep "${AUTOTUNE_AFTER:-90}"; "$0" autotune --auto ) >>"$OSLOG" 2>&1 &
        fi

        rotate_logs
        args=$(build_args)
        printf '%s\n' "$args" > "$ARGSFILE"
        started=$(date +%s)
        log_os "start: $bin $args"
        # Five minutes of hashing is the success criterion for a boot: long
        # enough for a bad kernel, a missing module or a broken squashfs to have
        # failed, short enough that the rollback happens on the same visit.
        ( sleep 300; mark_boot_ok ) &
        # shellcheck disable=SC2086
        "$bin" $args &
        child=$!
        printf '%s\n' "$child" > "$PIDFILE"

        set +e
        wait "$child"
        rc=$?
        set -e

        rm -f "$PIDFILE"
        ran=$(( $(date +%s) - started ))
        log_os "exit $rc after ${ran}s"

        # "Five failed starts in a row" is what the reboot is for, so a start
        # that actually lasted has to clear the count. Without this a rig that
        # crashes once a week walked to a reboot once a month, and the reboot
        # told nobody anything: the last failure was five weeks old.
        if [ "$ran" -ge "${HEALTHY_RUN:-$(plan_healthy_run 2>/dev/null || printf 600)}" ]; then
            [ "$fails" = "0" ] || log_os "ran for ${ran}s: clearing the failure count"
            fails=0
        fi

        # `zmrig-os autotune` asked for this: it wrote the new thread count and
        # killed the miner so this loop would pick it up. Counting it as a
        # failure would walk a perfectly healthy rig towards the reboot limit.
        if [ -e "$RUN/reload" ]; then
            rm -f "$RUN/reload"
            fails=0
            log_os "reloading with the thread count autotune chose"
            sleep 1
            continue
        fi

        # A clean 0 is the user stopping us. Anything else is a crash, a pool
        # that stayed refused, or the health restart deciding the miner was
        # wedged; all of those are worth retrying, and none of them are worth
        # rebooting over until they happen five times in a row.
        [ "$rc" = "0" ] && exit 0

        fails=$((fails + 1))
        if [ "$fails" -ge 5 ] && [ "${AUTO_REBOOT:-1}" = "1" ] && is_root; then
            log_os "5 failed starts in a row; rebooting so the rig comes back unattended"
            run sync
            run reboot
            exit 1
        fi

        # A crash loop is usually the pool or the network, and hammering it every
        # ten seconds turns a five-minute outage into a socket storm. The delay
        # doubles up to five minutes; the arithmetic is in plan.sh so the test
        # suite can check the shape of it without waiting ten minutes.
        delay=$(plan_restart_delay "$fails" 2>/dev/null || printf '10')
        log_os "restarting in ${delay}s (failure $fails)"
        sleep "$delay"
    done
}

# --------------------------------------------------------------- commands

cmd_setup() {
    local wallet="" pool="" mode="" threads="" worker="" donate="" maxtemp="" start=0 interactive=1

    while [ $# -gt 0 ]; do
        case "$1" in
            --wallet)  wallet="${2:?}"; shift ;;
            --wallet=*) wallet="${1#*=}" ;;
            --pool)    pool="${2:?}"; shift ;;
            --pool=*)  pool="${1#*=}" ;;
            --mode)    mode="${2:?}"; shift ;;
            # Into a local, not into $SAFE_TEMP: load_conf() runs after this
            # loop and would put the file's value straight back, which is what
            # made `setup --max-temp 77` print "safe (holding 72 C)" and write
            # 72. Same trap as --donate below.
            --max-temp) maxtemp="${2:?}"; shift ;;
            --max-temp=*) maxtemp="${1#*=}" ;;
            --mode=*)  mode="${1#*=}" ;;
            --threads|--threads=*) threads="${1#*=}"; [ "$threads" = "$1" ] && { threads="${2:?}"; shift; } ;;
            --worker)  worker="${2:?}"; shift ;;
            --worker=*) worker="${1#*=}" ;;
            --donate|--donate=*)
                # Parsed into a local, not into $DONATE: load_conf() runs after
                # this loop and would put the old file value back.
                donate="${1#*=}"
                if [ "$donate" = "$1" ]; then donate="${2:?}"; shift; fi ;;
            --start)   start=1 ;;
            --yes|-y)  interactive=0 ;;
            *) die "unknown option: $1" ;;
        esac
        shift
    done

    load_conf

    # Non-interactive when any value was given on the command line, or when the
    # caller asked for it. A fleet boot passes everything through the kernel
    # command line, so it must never end up waiting at a prompt.
    if [ -z "$wallet" ] && [ -z "$pool" ] && [ -z "$mode" ] && [ "$interactive" = "1" ] && [ -c /dev/tty ]; then
        printf '\n ZMRIG OS setup\n ---------------\n\n'
        # Three tries, with the reason. A person plugging in a screen and a
        # keyboard is the one operator who can fix a typo, and `die` on the
        # first one means they reboot the machine to try again - or worse, walk
        # away from a rig that sits at "no wallet configured" for a week. The
        # decode happens here, so a wrong character is refused at the console
        # rather than after the first rejected login.
        attempt=0
        while :; do
            printf 'Monero wallet address: '
            read -r wallet < /dev/tty || wallet=""
            [ -n "$wallet" ] || die "a wallet address is required (--wallet)"
            if validate_wallet "$wallet" "${ALGO:-auto}"; then
                break
            fi
            attempt=$((attempt + 1))
            printf '\n That address cannot be paid: %s\n' "$(explain_wallet "$wallet" 2>/dev/null || printf 'wrong shape')"
            if [ "$attempt" -ge 3 ]; then
                die "giving up after three attempts; run 'zmrig-os setup' again when you have the address"
            fi
            printf ' Try again (ctrl-c to stop).\n\n'
        done
        printf 'Pool host:port [%s]: ' "$POOL_DEFAULT"
        read -r pool < /dev/tty
        printf 'Worker name [%s]: ' "$(hostname 2>/dev/null || echo rig)"
        read -r worker < /dev/tty
        printf 'Mode - max (all cores), balanced, eco, light [%s]: ' "$MODE_DEFAULT"
        read -r mode < /dev/tty
    fi

    [ -n "$wallet" ] || die "a wallet address is required (--wallet)"
    if ! validate_wallet "$wallet" "${ALGO:-auto}"; then
        # Say which kind of wrong it is. "Not valid" makes an operator re-type a
        # 95-character string hoping for the best; "checksum does not match" tells
        # them the string is the right shape and one character is off.
        die "that is not a valid Monero address: $(explain_wallet "$wallet" 2>/dev/null || printf '95 characters, base58, starting with 4 or 8')"
    fi

    WALLET="$wallet"
    [ -n "$pool" ] && POOL="$pool"
    [ -n "$worker" ] && WORKER="$worker"
    [ -n "$mode" ] && MODE="$mode"
    if [ -n "$maxtemp" ]; then
        case "$maxtemp" in
            *[!0-9]*) die "--max-temp must be a whole number of degrees Celsius" ;;
        esac
        [ "$maxtemp" -ge 45 ] && [ "$maxtemp" -le 95 ] ||
            die "--max-temp must be 45..95 degrees Celsius"
        SAFE_TEMP="$maxtemp"
    fi
    if [ -n "$threads" ]; then
        THREADS="$threads"
        # A hand-picked count is not a measurement, and leaving one behind
        # would have the drift watcher comparing the new count against a rate
        # the old one produced.
        AUTOTUNED=""
        MEASURED_THREADS=""
        MEASURED_HS=""
        TUNED_AT=""
    fi
    [ -n "$donate" ] && DONATE="$donate"

    case "$MODE" in
        max|balanced|eco|light|safe) ;;
        *) die "unknown mode: $MODE (max, balanced, eco, light, safe)" ;;
    esac

    save_conf
    say "wallet  $WALLET"
    say "pool    $POOL"
    say "worker  $WORKER"
    say "mode    $MODE$( [ "$MODE" = "safe" ] && printf ' (holding %s C)' "$SAFE_TEMP" )"
    say "saved to $CONF"

    if [ "$start" = "1" ]; then
        cmd_boot
    fi
}

cmd_mode() {
    local mode="${1:-}" temp="${2:-}"
    [ -n "$mode" ] || die "usage: zmrig-os mode max|balanced|eco|light|safe [TEMP_C]"
    load_conf

    case "$mode" in
        max|balanced|eco|light|safe) ;;
        *) die "unknown mode: $mode (max, balanced, eco, light, safe)" ;;
    esac

    if [ -n "$temp" ]; then
        case "$temp" in
            ''|*[!0-9]*) die "not a temperature: $temp (whole degrees Celsius, 45..95)" ;;
        esac
        [ "$temp" -ge 45 ] && [ "$temp" -le 95 ] ||
            die "not a usable temperature: ${temp} C (45..95; below that the rig stops for ever, above it protects nothing)"
        SAFE_TEMP="$temp"
    fi

    MODE="$mode"
    # Every mode caps threads differently (safe sheds them under heat, eco and
    # light start lower), so a count measured under the old mode is the wrong
    # answer for the new one: clear the marker and let the supervisor re-measure.
    AUTOTUNED=""
    MEASURED_THREADS=""
    MEASURED_HS=""
    TUNED_AT=""
    save_conf
    say "mode $MODE; $(build_args)"

    if [ "$THREADS" = "auto" ] && running; then
        say "the thread count goes back to auto; it will be measured again"
    fi

    if running; then
        cmd_restart
    fi
}

# Keep N logical CPUs for mining, as whole SMT groups, and pin the miner to them.
#
# What this buys: the scheduler stops putting the pool's socket, the SSH session
# and the sysctl write on the cores that are hashing. What it costs: those CPUs
# are also unavailable to anything else, so `isolate N` on a 4-core box leaves 2
# cores for the OS and 2 for the miner.
#
# Half of it cannot be changed at runtime - isolcpus/nohz_full/rcu_nocbs are
# parsed before the scheduler exists - so on an installed rig the parameters are
# written into the GRUB environment block and take effect on the next boot. On a
# live stick the media is read-only: the tool prints the parameters to add to the
# boot entry and applies the user-space half (affinity and IRQ steering) now.
cmd_isolate() {
    local want="${1:-show}" total cpus house params

    load_conf
    total=$(thread_count)

    case "$want" in
        show|"")
            say "cpus        $total logical ($(plan_join_list $(seq 0 $((total - 1))) 2>/dev/null || echo "?"))"
            if [ -n "${ISOLATED_CPUS:-}" ]; then
                say "isolated    $(iso_list) ($(printf '%s' "$ISOLATED_CPUS" | wc -w) of the ${ISOLATE} asked for)"
                say "housekeeping $(housekeeping_list)"
                say "affinity    --cpu-affinity 0x$(plan_mask_hex $ISOLATED_CPUS)"
            else
                say "isolated    none (zmrig-os isolate N)"
            fi
            if is_installed; then
                params=$(read_grubenv zmrig_extra)
                say "next boot   ${params:-no kernel parameters set}"
            else
                say "next boot   a live stick boots with the parameters in its GRUB entry"
            fi
            return 0
            ;;
        off) want=0 ;;
    esac

    case "$want" in
        *[!0-9]*) die "usage: zmrig-os isolate N | isolate off | isolate" ;;
    esac

    if [ "$want" -ge "$total" ]; then
        die "cannot isolate ${want} of ${total} CPUs: at least one has to stay with the kernel"
    fi

    cpus=$(plan_iso_cpus "$SYS" "$want" "$total")
    if [ "$want" -gt 0 ] && [ -z "$cpus" ]; then
        die "cannot take ${want} CPUs out of ${total}: no whole cores are free on this machine"
    fi

    # What the SMT rule actually produced, not what was asked for: the difference
    # is the machine's topology, and silently rounding would misdescribe it.
    [ "$want" = "0" ] || ISOLATE=$(printf '%s' "$cpus" | wc -w)
    [ "$want" = "0" ] && ISOLATE=0
    ISOLATED_CPUS="$cpus"
    save_conf

    if [ "$ISOLATE" = "0" ]; then
        say "isolation off: every CPU is available to the kernel (applies on the next miner start)"
    else
        say "isolated $(iso_list): ${ISOLATE} logical CPU(s) for mining, $(housekeeping_list) for the kernel"
        say "the miner is pinned with --cpu-affinity 0x$(plan_mask_hex $ISOLATED_CPUS) on its next start"
    fi

    # Kernel-side, next boot, when there is somewhere to write it.
    if is_installed; then
        if write_boot_params; then
            say "reboot once to put the kernel side in place (isolcpus, nohz_full, rcu_nocbs)"
        else
            warn "could not write the GRUB environment block; add these by hand instead:"
            [ -z "$cpus" ] || say "  isolcpus=$(iso_list) nohz_full=$(iso_list) rcu_nocbs=$(iso_list)"
        fi
    else
        say "live stick: the boot entry is on read-only media, so the kernel side has to be"
        say "typed once (press 'e' in GRUB) or built in:"
        [ -z "$cpus" ] || say "  isolcpus=$(iso_list) nohz_full=$(iso_list) rcu_nocbs=$(iso_list)"
    fi

    if running; then
        say "restarting the miner so the new affinity applies"
        cmd_restart
    fi
}

# Does the 1 GiB pool reserved at boot already hold everything this run needs?
#
# The miner asks for gigantic pages first and falls back to the 2 MiB pool, so a
# rig with a big enough pool needs no second reservation — and cannot afford one:
# `hugepages=3` has already taken 3 GB of contiguous memory, and another 2.3 GB
# of 2 MiB pages on the same machine is how a rig ends up swapping while it mines.
gigantic_covers() {
    local giga need
    giga=$(cat "$SYS/kernel/mm/hugepages/hugepages-1048576kB/nr_hugepages" 2>/dev/null || echo 0)
    case "${giga:-x}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$giga" -gt 0 ] || return 1
    [ "${HUGEPAGES:-}" = "0" ] && return 1
    need=$(plan_need_mb "$ALGO" "$MODE" "$(core_count)" "$THREADS" 2>/dev/null || echo 0)
    [ "${need:-0}" -gt 0 ] || return 1
    [ "$((giga * 1024))" -ge "$need" ]
}

# The page the miner reads its dataset through.
#
# 2 MiB pages are the difference between 855 and 1033 H/s on a two-core box, so
# the reservation is a performance setting, not a detail. 1 GiB pages go further:
# a 2080 MB dataset is 1 040 TLB entries at 2 MiB and two at 1 GiB. The catch is
# that the gigantic pool can only be made early in boot, from unfragmented
# memory, so it is a kernel parameter and not a sysctl - which is why this
# command writes the boot block instead of poking /proc.
cmd_hugepages() {
    local want="${1:-show}" count="${2:-}" pages_2m page_kb need_mb have_1g giga_file

    load_conf
    giga_file="$SYS/kernel/mm/hugepages/hugepages-1048576kB/nr_hugepages"

    show_pools() {
        pages_2m=$(awk '/^HugePages_Total:/ { print $2 }' /proc/meminfo 2>/dev/null || echo 0)
        page_kb=$(awk '/^Hugepagesize:/ { print $2 }' /proc/meminfo 2>/dev/null || echo 0)
        need_mb=$(plan_need_mb "$ALGO" "$MODE" "$(thread_count)" 2>/dev/null || echo 0)
        [ "${HUGEPAGES:-}" = "0" ] && need_mb=0
        have_1g=$(cat "$giga_file" 2>/dev/null || echo 0)
        case "${have_1g:-x}" in ''|*[!0-9]*) have_1g=0 ;; esac

        say "2 MiB    ${pages_2m:-0} page(s) reserved of ${page_kb:-0} KB"
        if [ -r "$giga_file" ]; then
            say "1 GiB    ${have_1g} page(s) reserved"
        else
            say "1 GiB    this kernel has no 1 GiB pool"
        fi
        say "this run ${need_mb} MB: $(((need_mb + 1) / 2)) page(s) of 2 MiB, or $(((need_mb + 1023) / 1024)) of 1 GiB"
        if [ -n "${HUGEPAGES_1G:-}" ] && [ "${HUGEPAGES_1G}" != "0" ]; then
            say "boot     reserves ${HUGEPAGES_1G} x 1 GiB; 'zmrig-os hugepages off' removes that"
        fi
    }

    case "$want" in
        show|"")
            show_pools
            return 0
            ;;
        off|none|no|0)
            HUGEPAGES_1G=""
            ;;
        1g|1G|gigantic)
            case "${count:-}" in
                ''|*[!0-9]*) die "usage: zmrig-os hugepages 1g N (N pages of 1 GiB), or 'hugepages off'" ;;
            esac
            HUGEPAGES_1G="$count"
            [ "$count" = "0" ] && HUGEPAGES_1G=""
            ;;
        *[!0-9]*)
            die "usage: zmrig-os hugepages [1g N | off]"
            ;;
        *)
            # A bare number is a 1 GiB count too: it is the only thing this
            # command reserves, because the 2 MiB pool is already handled by the
            # initramfs from HUGEPAGES and the algorithm.
            HUGEPAGES_1G="$want"
            [ "$want" = "0" ] && HUGEPAGES_1G=""
            ;;
    esac

    save_conf

    if [ -z "${HUGEPAGES_1G:-}" ]; then
        say "1 GiB pages off: the mapping uses 2 MiB pages"
    else
        say "1 GiB pages: ${HUGEPAGES_1G} page(s), $((HUGEPAGES_1G * 1024)) MB, reserved at the next boot"
    fi

    if is_installed; then
        if write_boot_params; then
            say "reboot once: the gigantic pool cannot be created after the machine has fragmented"
        else
            warn "could not write the GRUB environment block; add this to the kernel line by hand:"
            say "  default_hugepagesz=1G hugepagesz=1G hugepages=${HUGEPAGES_1G:-0}"
        fi
    else
        say "live stick: the boot entry is read-only - press 'e' in GRUB and add:"
        say "  default_hugepagesz=1G hugepagesz=1G hugepages=${HUGEPAGES_1G:-0}"
    fi
}

# Everything a rig needs, in one command, so a fleet is a loop over a list of
# wallets rather than a sequence of six commands that must be given in order.
#
#   zmrig-os quickstart --wallet 4... [--pool host:port] [--coin xmr]
#                       [--mode max] [--fleet https://...] [--no-start]
cmd_quickstart() {
    local wallet="" pool="" coin="" mode="" fleet="" start=1

    while [ $# -gt 0 ]; do
        case "$1" in
            --wallet)   wallet="${2:?--wallet needs an address}" ; shift ;;
            --wallet=*) wallet="${1#*=}" ;;
            --pool)     pool="${2:?--pool needs host:port}" ; shift ;;
            --pool=*)   pool="${1#*=}" ;;
            --coin)     coin="${2:?}" ; shift ;;
            --coin=*)   coin="${1#*=}" ;;
            --mode)     mode="${2:?}" ; shift ;;
            --mode=*)   mode="${1#*=}" ;;
            --fleet)    fleet="${2:?--fleet needs a URL}" ; shift ;;
            --fleet=*)  fleet="${1#*=}" ;;
            --no-start) start=0 ;;
            -h|--help)  sed -n '/^cmd_quickstart()/,/^}/p' "$0" | sed -n 's/^# \{0,1\}//p' ; return 0 ;;
            *) die "unknown option: $1 (zmrig-os quickstart --help)" ;;
        esac
        shift
    done

    load_conf
    [ -n "$wallet" ] || [ -n "$WALLET" ] ||
        die "no wallet: pass --wallet 4... (or run this again after 'zmrig-os setup')"

    [ -z "$wallet" ] || WALLET="$wallet"
    validate_wallet "$WALLET" "${coin:-$ALGO}" ||
        die "that is not a valid address for ${coin:-$ALGO}: $(explain_wallet "$WALLET" 2>/dev/null || printf 'wrong shape or alphabet')"

    if [ -n "$pool" ]; then
        case "$pool" in
            *:*) POOL="$pool" ;;
            *) die "a pool is host:port, for example gulf.moneroocean.stream:10001" ;;
        esac
    fi
    [ -z "$coin" ] || ALGO="$coin"
    if [ -n "$mode" ]; then
        case "$mode" in
            max|balanced|eco|light|safe) MODE="$mode" ;;
            *) die "unknown mode: $mode (max, balanced, eco, light, safe)" ;;
        esac
    fi
    if [ -n "$fleet" ]; then
        case "$fleet" in
            https://*|http://*) FLEET_URL="$fleet" ;;
            *) die "the fleet URL must start with https:// (or http:// on a LAN)" ;;
        esac
    fi

    # A new wallet or algorithm invalidates the thread count measured for the
    # old one: the memory per thread changed, so the answer changed with it.
    AUTOTUNED=""
    MEASURED_THREADS=""
    MEASURED_HS=""
    TUNED_AT=""
    save_conf

    say "wallet      $(wallet_short)"
    say "pool        $POOL"
    say "coin        $ALGO, mode $MODE"

    if is_root; then
        cmd_tune >/dev/null 2>&1 || warn "the tuner did not finish; the rig mines anyway"
        say "tuning      applied (huge pages, THP, governor)"
    else
        warn "not root: nothing was tuned (run again as root, or reboot)"
    fi

    if [ -n "$fleet" ]; then
        say "fleet       $FLEET_URL"
        cmd_device | sed 's/^/  /'
    fi

    if [ "$start" = "1" ]; then
        [ -n "$fleet" ] || cmd_device | sed 's/^/  /'
        cmd_restart >/dev/null 2>&1 || cmd_start >/dev/null 2>&1 || warn "the miner did not start; see zmrig-os logs"
        sleep 1
        if running; then
            say "mining      started (pid $(cat "$PIDFILE" 2>/dev/null))"
        else
            warn "the miner is not running; 'zmrig-os status' says why"
        fi
    fi

    say ""
    say "next: zmrig-os status | zmrig-os logs 40 | zmrig-os doctor | zmrig-os isolate 4"
}

cmd_boot() {
    # Everything the boot needs, in the order the kernel allows it: pages first
    # while memory is still unfragmented, then the clock, then the miner.
    load_conf

    # zmrig.os.install=/dev/sdX: write this image onto that disk and reboot into
    # it. This is the headless path - Ventoy, a fleet, or a machine whose only
    # console is a serial port - and it is deliberately the *first* thing that
    # happens, before mining, because it ends in a reboot.
    if [ -n "${INSTALL:-}" ]; then
        say "zmrig.os.install=${INSTALL}: installing, then rebooting"
        if cmd_install --disk "$INSTALL" --yes; then
            run sync
            run reboot
            exit 0
        fi
        warn "the install did not finish; starting the miner on the live image"
        INSTALL=""
    fi

    cmd_tune || warn "tuning reported a problem; mining anyway"

    if [ -z "$WALLET" ]; then
        if [ -c /dev/tty ] && [ -t 1 ]; then
            cmd_setup || die "setup did not complete"
        else
            die "no wallet: pass zmrig.os.wallet=4... on the kernel command line or run 'zmrig-os setup'"
        fi
    fi

    cmd_start
}

cmd_tune() {
    local tune cores irq algo_args huge_args
    # `zmrig-os tune` is documented as a standalone command and used to depend on
    # its caller having loaded the config.
    load_conf
    tune=$(P /usr/local/lib/zmrig/tune-linux.sh)

    if [ ! -x "$tune" ]; then
        warn "no tuner at $tune"
        return 1
    fi

    # The image has no udev, so a hwmon chip is loaded by name or not at all.
    # coretemp and k10temp are in /etc/modules; these four are the ones that turn
    # "no sensor in /sys" into a working thermal governor on a desktop board
    # (Super I/O at 0x290, the I2C bus that reaches it, and the disk that reports
    # its own temperature). A module the kernel does not have fails silently.
    if is_root && [ "$DRYRUN" = "0" ]; then
        for mod in msr coretemp k10temp nct6775 it87 i2c-i801 i2c-piix4 i2c-nct6775 drivetemp; do
            modprobe -q "$mod" 2>/dev/null || true
        done
    fi

    # THP is `always` for max and balanced, matching the GRUB entries: with the
    # reserved pool the policy matters little, but when the reservation fails
    # (too little RAM, a container) it is worth ~28 % and `madvise` is not
    # enough for every mapping the miner creates.
    # Steering interrupts only makes sense when there is somewhere to steer them
    # to: on a two-core box, moving every IRQ onto CPU 0 moves half the machine's
    # work onto the core the miner is also using.
    cores=$(core_count)
    [ "${cores:-1}" -ge 4 ] && irq="steer" || irq="keep"

    # The algorithm decides how much memory is reserved, and it is the same
    # number the initramfs used: a Scala rig must not have Monero's 2.3 GB
    # reserved for it, and a Monero rig must not be short.
    algo_args="--algo ${ALGO:-auto} --mode ${MODE:-max}"
    case "${HUGEPAGES:-}" in
        # HUGEPAGES is a count, and it says "exactly this", including 0 for none.
        # Anything that is not a number is a page size (2M, 1G) or the word auto.
        0|off|no)  huge_args="--hugepages off" ;;
        ''|auto)   huge_args="--hugepages 2M" ;;
        *[!0-9]*)  huge_args="--hugepages ${HUGEPAGES}" ;;
        *)         huge_args="--hugepages 2M --pages ${HUGEPAGES}" ;;
    esac

    # A gigantic pool that already covers this run must not be topped up with
    # 2 MiB pages: on a 4 GB box the two reservations together do not fit, and
    # the one that loses is the one holding the dataset. The miner maps whichever
    # pool exists, so "leave it alone" is `--hugepages off`.
    if gigantic_covers; then
        huge_args="--hugepages off"
    fi

    # NUMA balancing migrates pages while a process runs, which for a uniformly
    # random walk over 2.3 GiB is a stalled hash that buys nothing. In light mode
    # the machine is somebody's desktop, so it is left alone.
    case "$MODE" in
        eco)   run "$tune" $huge_args $algo_args --profile watt --thp madvise --swappiness 10 --numa off --irq "$irq" ;;
        safe)  run "$tune" $huge_args $algo_args --profile watt --thp madvise --swappiness 10 --numa off --irq "$irq" ;;
        light) run "$tune" --hugepages off $algo_args --thp always --swappiness 10 --numa keep --irq keep ;;
        *)     run "$tune" $huge_args $algo_args --profile free --thp always --swappiness 1 --numa off --irq "$irq" ;;
    esac
}

cmd_start() {
    load_conf
    if running; then
        say "already mining (pid $(cat "$PIDFILE"))"
        return 0
    fi
    mkdir -p "$RUN"
    # Detached from the terminal so the command returns; the supervisor keeps
    # its own log.
    nohup "$0" run >>"$OSLOG" 2>&1 &
    sleep 1
    if running; then
        say "started (pid $(cat "$PIDFILE"))"
    else
        say "start requested; see $OSLOG"
    fi
}

cmd_stop() {
    if running; then
        local pid
        pid=$(cat "$PIDFILE")
        kill "$pid" 2>/dev/null || true
        sleep 1
        kill -9 "$pid" 2>/dev/null || true
        rm -f "$PIDFILE"
        say "stopped"
    else
        say "not running"
    fi
}

cmd_restart() {
    cmd_stop
    sleep 1
    cmd_start
}

last_rate() {
    [ -f "$LOG" ] || { printf '?'; return 0; }
    # "speed 10s/60s/15m 901.6 900.1 899.0 H/s max 950.0 H/s"
    grep -a 'speed 10s/60s/15m' "$LOG" 2>/dev/null | tail -1 |
        awk '{ for (i = 1; i <= NF; i++) if ($i == "H/s") { print $(i - 1); exit } }' |
        { read -r rate || true; printf '%s' "${rate:-?}"; }
}

cmd_status() {
    load_conf
    local state="stopped" pid="-" rate
    if running; then
        state="mining"
        pid=$(cat "$PIDFILE")
    fi
    rate=$(last_rate)

    printf '%-14s %s\n' "state"    "$state"
    printf '%-14s %s\n' "pid"      "$pid"
    printf '%-14s %s\n' "hashrate" "$rate H/s"
    # Where the thread count came from matters more than the number: "auto" is
    # the heuristic, "auto (measuring)" is a rig that will reload once with a
    # measured answer, and a number is a decision somebody or something made.
    if [ "$THREADS" = "auto" ]; then
        if [ -n "$AUTOTUNED" ]; then printf '%-14s %s\n' "threads" "auto (pinned from a measurement that no longer applies)"
        elif [ "$AUTO_AUTOTUNE" = "1" ] && running; then printf '%-14s %s\n' "threads" "auto (the machine is being measured)"
        else printf '%-14s %s\n' "threads" "auto"; fi
    else
        printf '%-14s %s\n' "threads" "$THREADS"
    fi
    # What the machine did when it was measured, next to what it does now: the
    # pair is the only way to see drift without waiting for the watcher to act.
    if [ -n "$MEASURED_HS" ]; then
        local age="at some point" h
        if [ -n "$TUNED_AT" ]; then
            h=$(( ( $(date +%s) - TUNED_AT ) / 3600 ))
            # Hours up to two days, then days: "498251 h ago" is a number nobody
            # reads, and the age is the part that says whether to trust it.
            if [ "$h" -ge 48 ]; then age="$(( h / 24 )) d ago"; else age="${h} h ago"; fi
        fi
        printf '%-14s %s\n' "measured" "${MEASURED_HS} H/s at ${MEASURED_THREADS:-?} thread(s), ${age}"
    fi
    printf '%-14s %s\n' "wallet"   "$(wallet_short)"
    printf '%-14s %s\n' "pool"     "$POOL"
    printf '%-14s %s\n' "worker"   "$WORKER"
    printf '%-14s %s\n' "mode"     "$MODE$( [ "$MODE" = "safe" ] && printf ' (max %s C)' "$SAFE_TEMP" )"
    printf '%-14s %s\n' "form"     "$( if is_installed; then printf 'installed on %s, slot %s' "$(media_label)" "$(boot_slot)"; else printf 'live image (nothing is written to disk)'; fi )"
    printf '%-14s %s\n' "updates"  "$( if [ "${AUTO_UPDATE:-1}" = "1" ]; then printf 'daily, automatically'; [ "${AUTO_IMAGE:-0}" = "1" ] && printf ' (including the OS image, with rollback)'; else printf 'off (AUTO_UPDATE=0)'; fi )"
    # Huge pages and where the threads are allowed to run: the two numbers a
    # "why is it slower than yesterday" question usually turns into.
    printf '%-14s %s\n' "hugepages" "$(awk '/^HugePages_Total:/ { print $2 " x " $3 }' /proc/meminfo 2>/dev/null || echo '?')$( [ -n "${HUGEPAGES:-}" ] && printf ' (HUGEPAGES=%s)' "$HUGEPAGES" )$( [ -n "${HUGEPAGES_1G:-}" ] && [ "${HUGEPAGES_1G}" != "0" ] && printf ' + %s x 1G at boot' "$HUGEPAGES_1G" )"
    printf '%-14s %s\n' "cpus"     "$( if [ -n "${ISOLATED_CPUS:-}" ]; then printf 'mining on %s, kernel on %s' "$(iso_list)" "$(housekeeping_list)"; else printf 'shared (zmrig-os isolate N keeps some for mining)'; fi )"
    printf '%-14s %s\n' "thermal"  "$(thermal_now)"
    printf '%-14s %s\n' "fee"      "${DONATE}% of Monero time (--donate-level=0 to turn off)"
    printf '%-14s %s\n' "device"   "$(device_id 2>/dev/null || echo '?')"
    printf '%-14s %s\n' "fleet"    "$( if [ -n "$(fleet_url)" ]; then printf '%s (checked in %s)' "$(fleet_url)" "$( if [ -f "${RUN}/sync.last" ]; then printf '%s s ago' "$(( $(date +%s) - $(cut -d' ' -f1 "${RUN}/sync.last") ))"; else printf 'never'; fi )"; else printf 'not configured'; fi )"
    printf '%-14s %s\n' "version"  "$(image_version) ($( "$(zmrig_bin)" --version 2>/dev/null | head -1 || echo 'miner not installed'))"
}

# The temperature the governor is acting on.
#
# Not "the first sensor that exists": a board exposes a dozen of them and the
# one that matters is the CPU die. Read in tiers, and inside a tier take the
# hottest reading, because coretemp publishes one file per core and a governor
# watching core 0 while core 5 cooks is not a governor.
#
#   tier 1  the CPU die: coretemp, k10temp, zenpower, k8temp, the ACPI
#           processor zone, x86_pkg_temp
#   tier 2  the board: the Super I/O chips (nct6775/6683/6687, it87), the
#           vendor ECs (asus, dell_smm, thinkpad, applesmc), sp5100_tco
#   tier 3  anything else, except acpitz
#   tier 4  acpitz, and only acpitz: it reports a southbridge estimate that
#           sits 10-20 C below the die, which is how a rig cooks with the fan
#           controller convinced it is cold
thermal_now() {
    local f name t best want
    local sys="$SYS"
    for want in cpu board other; do
        best=""
        for f in "$sys"/class/hwmon/hwmon*/temp*_input; do
            [ -r "$f" ] || continue
            name=$(cat "$(dirname "$f")/name" 2>/dev/null) || continue
            case "$want:$name" in
                cpu:coretemp|cpu:k10temp|cpu:zenpower|cpu:k8temp|cpu:cpu_thermal) ;;
                cpu:cpu-thermal|cpu:soc_thermal|cpu:x86_pkg_temp|cpu:fam15h_power) ;;
                board:nct6775|board:nct6683|board:nct6687|board:it87|board:sp5100_tco) ;;
                board:asus|board:asus_wmi_sensors|board:dell_smm|board:thinkpad) ;;
                board:applesmc|board:ec_sys) ;;
                other:*)
                    # Everything the board did not label, apart from the tier-4
                    # guess that would otherwise win by being the last resort.
                    case "$name" in acpitz) continue ;; esac
                    ;;
                *) continue ;;
            esac
            t=$(cat "$f" 2>/dev/null) || continue
            case "$t" in ''|*[!0-9-]*) continue ;; esac
            if [ "$t" -gt 0 ] && { [ -z "$best" ] || [ "$t" -gt "$best" ]; }; then
                best="$t"
            fi
        done
        if [ -n "$best" ]; then
            printf '%s C' "$((best / 1000))"
            return 0
        fi
    done

    # No hwmon driver (a kernel without CONFIG_SENSORS_*, or a VM). The thermal
    # zones are ACPI's own answer: still acpitz last, still the hottest first.
    best=""
    local guessed=""
    for f in "$sys"/class/thermal/thermal_zone*/temp; do
        [ -r "$f" ] || continue
        t=$(cat "$f" 2>/dev/null) || continue
        case "$t" in ''|*[!0-9-]*) continue ;; esac
        [ "$t" -gt 0 ] || continue
        if [ "$(cat "$(dirname "$f")/type" 2>/dev/null)" = "acpitz" ]; then
            if [ -z "$guessed" ] || [ "$t" -gt "$guessed" ]; then guessed="$t"; fi
        else
            if [ -z "$best" ] || [ "$t" -gt "$best" ]; then best="$t"; fi
        fi
    done
    [ -z "$best" ] && best="$guessed"

    if [ -z "$best" ]; then
        printf 'no sensor in /sys (the governor cannot act; see zmrig-os doctor)'
    else
        printf '%s C' "$((best / 1000))"
    fi
}

# The same reading as a plain number of degrees, or empty when there is none.
# Anything that parses thermal_now's output as a number gets 0 instead of a
# temperature ("68 C" has a space in it), which is how the fleet payload sent a
# temperature of zero for every rig while the status line printed a real one.
thermal_c() {
    local t
    t=$(thermal_now 2>/dev/null) || return 0
    case "$t" in
        *" C") printf '%s' "${t% C}" ;;
        *)     printf '' ;;
    esac
}

wallet_short() {
    if [ -n "$WALLET" ]; then
        printf '%s...%s' "$(printf '%s' "$WALLET" | cut -c1-8)" "$(printf '%s' "$WALLET" | tail -c 6)"
    else
        printf '(unset)'
    fi
}

cmd_args() {
    load_conf
    printf '%s\n' "$(build_args)"
}

cmd_logs() {
    local lines="${1:-40}"
    [ -f "$LOG" ] || die "no log at $LOG yet"
    tail -n "$lines" "$LOG"
}

cmd_bench() {
    local seconds="${1:-30}" bin args
    load_conf
    bin=$(zmrig_bin)
    args=$(build_args)
    # A benchmark has to measure the same configuration the rig would mine, so
    # it reuses the mode flags and only swaps the target for --bench.
    args=$(printf '%s' "$args" | sed 's/ --health-restart [0-9]*//; s/ --print-time [0-9]*//')
    # shellcheck disable=SC2086
    exec "$bin" $args --bench=$(( seconds * 1000 ))
}

# Threads are the one setting where the best answer is machine-specific: the
# cache heuristic assumes 2 MiB of L3 per thread, which is right for a stock
# Ryzen and wrong for a machine with a small or uneven L3. zmrig can measure it
# (`--autotune`), so the image offers that instead of asking the operator to
# guess; the winning count is written to the config and survives restarts.
#
#   zmrig-os autotune                 measure and pin the result
#   zmrig-os autotune --seconds 20    a longer sample on a noisy machine
#   zmrig-os autotune --auto          what the supervisor runs on its own
#   zmrig-os autotune --auto --retune the same, even though a measurement exists
#                                     (what the drift watcher runs)
#
# It tunes the machine *first*. Measuring threads on an untuned box answers the
# wrong question: a powersave governor, THP off and no huge pages give every
# candidate the same handicap, and the number it picks is the best of a bad set.
cmd_autotune() {
    local seconds="8" auto=0 retune=0 bin args out best tuned=0 rate unit measured=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --auto)         auto=1 ;;
            --retune)       retune=1 ;;
            --seconds)      seconds="${2:?}"; shift ;;
            --seconds=*)    seconds="${1#*=}" ;;
            ''|*[!0-9]*)    die "unknown option: $1 (try --seconds N or --auto)" ;;
            *)              seconds="$1" ;;
        esac
        shift
    done

    case "$seconds" in
        ''|*[!0-9]*) die "not a number of seconds: $seconds" ;;
    esac

    load_conf
    bin=$(zmrig_bin)

    if [ ! -x "$bin" ]; then
        # In --auto a missing binary is not an error: the supervisor will say so
        # on its own every time it tries to start.
        [ "$auto" = "1" ] && return 0
        die "miner binary not found: $bin"
    fi

    # A machine that was measured once and has since fallen off its own number
    # is the one case --auto must not skip: there is a measurement, and that is
    # the reason to look again. A count chosen by hand is still never touched,
    # and the drift watcher checks that before it asks for this.
    if autotune_due "$THREADS" "$AUTOTUNED" "$AUTO_AUTOTUNE"; then
        :
    elif [ "$auto" = "1" ] && [ "$retune" = "0" ]; then
        return 0
    elif [ "$retune" = "1" ] && [ "$AUTOTUNED" != "1" ]; then
        # Nothing to re-measure: the measurement this was meant to revisit is
        # gone (a mode change did it).
        return 0
    fi

    if cmd_tune; then tuned=1; fi

    args=$(build_args)
    # Drop the flags that make no sense for a benchmark, including -t: this
    # command exists to choose it.
    args=$(printf '%s' "$args" | sed 's/ -t [0-9]*//; s/ --health-restart [0-9]*//; s/ --print-time [0-9]*//')
    args=$(printf '%s' "$args" | sed 's| --log-file [^ ]*||')

    say "measuring this machine, ${seconds}s per candidate (this builds the dataset each time)"
    if ! out=$("$bin" $args --autotune="$seconds" 2>&1); then
        [ "$auto" = "1" ] && { log_os "autotune failed; keeping THREADS=$THREADS"; return 0; }
        die "the autotune run failed"
    fi

    printf '%s\n' "$out" | grep -E '^ *[0-9]+ |^best:|^autotune-best' || true
    best=$(printf '%s\n' "$out" | sed -n 's/^autotune-best-threads=\([0-9]*\)$/\1/p' | tail -1)
    if [ -z "$best" ]; then
        [ "$auto" = "1" ] && { log_os "autotune printed no thread count; keeping THREADS=$THREADS"; return 0; }
        die "autotune printed no thread count"
    fi

    # The rate the winner produced is the number this machine should keep
    # producing; keeping it is what turns "measured once" into "still on spec".
    rate=$(printf '%s\n' "$out" | sed -n 's/^autotune-best-rate=\(.*\)$/\1/p' | tail -1)
    unit=$(printf '%s\n' "$out" | sed -n 's/^autotune-rate-unit=\(.*\)$/\1/p' | tail -1)
    if measured=$(to_hs "$rate" "${unit:-H/s}" 2>/dev/null) && [ -n "$measured" ]; then
        MEASURED_HS="$measured"
    else
        MEASURED_HS=""
    fi
    MEASURED_THREADS="$best"
    TUNED_AT=$(date +%s)

    log_os "autotune: ${best} threads (was ${THREADS:-auto})${MEASURED_HS:+, ${MEASURED_HS} H/s}"
    THREADS="$best"
    AUTOTUNED="1"
    save_conf
    say "pinned ${best} thread(s) in $CONF (THREADS=\"auto\" goes back to the heuristic)"
    [ "$tuned" = "1" ] && say "the machine was tuned before measuring, so the number is the tuned one"

    # A measurement is worthless until the miner uses it.
    if running; then
        say "reloading the miner with the new thread count"
        signal_reload
    fi
    return 0
}

# What the tool decided about this machine, and why: the number a support ticket
# needs when a rig reports 8 threads on a 16-thread CPU and one core's worth of
# hashrate.
cmd_topology() {
    load_conf
    local cores threads mask
    cores=$(core_count)
    threads=$(thread_count)
    mask=$(affinity_mask)

    printf 'cores      %s physical, %s threads\n' "$cores" "$threads"
    printf 'mining on  %s\n' "$(mining_cpus | tr '\n' ' ' | sed 's/ *$//')"
    if [ -n "$mask" ]; then
        printf 'affinity   %s (--cpu-affinity)\n' "$mask"
    else
        printf 'affinity   none: %s\n' "$(affinity_reason)"
    fi
    printf 'threads    %s (THREADS=%s, mode %s)\n' \
        "$( [ "$THREADS" = "auto" ] && { t=$(mode_threads "$cores"); printf '%s' "${t:-the miner decides}"; } || printf '%s' "$THREADS" )" \
        "$THREADS" "$MODE"
}

# ------------------------------------------------------------------ hardware
# What the machine is, as opposed to what it is doing. RandomX's fast mode needs
# AVX2, AES-NI and 2 GB of dataset, and a machine missing any of those still
# hashes - it is just several times slower, which is worth saying out loud
# instead of leaving somebody to wonder why their rate is a fifth of the number
# in the README.

# Every processor's flags, not just the first one's: a heterogeneous machine (or
# a truncated dump) is not a reason to misjudge the CPU the miner will run on.
cpu_flags() {
    awk -F': ' '/^[Ff]lags|^Features/ { printf "%s ", $2 }' "$PROC/cpuinfo" 2>/dev/null
}

# 1 when the CPU advertises the flag, 0 when it does not (or cpuinfo is empty).
hw_has() {
    case " $(cpu_flags) " in
        *" $1 "*) printf '1' ;;
        *)        printf '0' ;;
    esac
}

mem_total_mb() {
    awk '/^MemTotal:/ { printf "%d", $2 / 1024 }' "$PROC/meminfo" 2>/dev/null || printf '0'
}

# The verdict, as a word, so it can be asserted without matching a sentence:
# small = cannot run at all, slow = runs much slower than it should,
# light = runs, but the dataset does not fit, full = everything RandomX wants.
hw_verdict() { # avx2, aes, mem_mb
    local avx2="$1" aes="$2" mem="${3:-0}"
    case "$mem" in ''|*[!0-9]*) mem=0 ;; esac
    if [ "$mem" -lt 1200 ]; then printf 'small'; return; fi
    if [ "$avx2" != 1 ] || [ "$aes" != 1 ]; then printf 'slow'; return; fi
    if [ "$mem" -lt 2400 ]; then printf 'light'; return; fi
    printf 'full'
}

hw_reason() { # verdict, mem_mb
    local verdict="$1" mem="${2:-0}"
    case "$verdict" in
        full)  printf 'fast mode: AVX2 and AES, and room for the 2 GB dataset' ;;
        light) printf 'runs, but %s MB will not hold the fast dataset: --mode light' "$mem" ;;
        slow)  printf 'no AVX2 or no AES: RandomX still hashes, several times slower (use the x86-64-v2 image)' ;;
        *)     printf 'under 1.2 GB of memory: too small to mine RandomX at all' ;;
    esac
}

cmd_hardware() {
    local model cores threads mem avx2 aes verdict flags=""
    model=$(awk -F': ' '/^model name/ { print $2; exit }' "$PROC/cpuinfo" 2>/dev/null)
    [ -n "$model" ] || model=$(awk -F': ' '/^(Model|Hardware)/ { print $2; exit }' "$PROC/cpuinfo" 2>/dev/null)
    [ -n "$model" ] || model=$(uname -m 2>/dev/null || printf 'unknown')

    cores=$(core_count)
    threads=$(thread_count)
    mem=$(mem_total_mb)
    avx2=$(hw_has avx2)
    aes=$(hw_has aes)
    verdict=$(hw_verdict "$avx2" "$aes" "$mem")

    [ "$avx2" = 1 ] && flags="$flags avx2"
    [ "$aes" = 1 ] && flags="$flags aes"
    [ "$(hw_has sha_ni)" = 1 ] && flags="$flags sha_ni"
    flags=${flags# }
    [ -n "$flags" ] || flags=none

    printf 'cpu        %s (%s cores, %s threads)\n' "$model" "$cores" "$threads"
    printf 'flags      %s\n' "$flags"
    printf 'memory     %s MB total\n' "$mem"
    if [ -f "$SYS/kernel/mm/transparent_hugepage/hugepages-1048576kB/enabled" ]; then
        printf 'pages      2 MB, and 1 GB pages are advertised\n'
    else
        printf 'pages      2 MB (no 1 GB pages)\n'
    fi
    printf 'verdict    %s: %s\n' "$verdict" "$(hw_reason "$verdict" "$mem")"

    # A machine that cannot run is worth a non-zero exit, so a provisioner can
    # stop rather than burn an afternoon on a box that will never be fast.
    case "$verdict" in
        full|light) return 0 ;;
        *)          return 1 ;;
    esac
}

affinity_reason() {
    case "${AFFINITY:-auto}" in
        off) printf 'disabled by AFFINITY=off' ;;
        auto) printf 'this machine reports no topology (a container, or a kernel without sysfs)' ;;
        *) printf 'AFFINITY is set to "%s" and it is not a mask the miner can use' "$AFFINITY" ;;
    esac
}

cmd_doctor() {
    local json=0
    case "${1:-}" in
        --json) json=1 ;;
        ""|-*) ;;
        *) die "usage: zmrig-os doctor [--json]" ;;
    esac

    load_conf
    local fails=0 warns=0 need_mb free_mb pages_need pages_have thp gov bin sev REPORT="" first=1

    # Every result is also kept, because --json is what a fleet reads and a
    # second implementation of the same checks is a second set of answers.
    REPORT=""
    check() { # status, name, detail
        local st="$1" name="$2" detail="$3"
        REPORT="${REPORT}${st} ${name} ${detail}
"
        [ "$json" = "1" ] && return 0
        case "$st" in
            ok)   printf '  PASS  %-22s %s\n' "$name" "$detail" ;;
            warn) printf '  WARN  %-22s %s\n' "$name" "$detail"; warns=$((warns + 1)) ;;
            *)    printf '  FAIL  %-22s %s\n' "$name" "$detail"; fails=$((fails + 1)) ;;
        esac
    }
    # In JSON mode the counters still have to move, so they are counted after the
    # fact from REPORT; check() above only prints when it is not JSON.
    tally() {
        fails=$(printf '%s' "$REPORT" | grep -c '^fail ' || true)
        warns=$(printf '%s' "$REPORT" | grep -c '^warn ' || true)
    }

    if [ -n "$PLAN_MISSING" ]; then
        check fail plan "os/plan.sh is missing from this image: the page and CPU numbers below are guesses"
    fi

    bin=$(zmrig_bin)
    if [ -x "$bin" ]; then check ok binary "$($bin --version 2>/dev/null | head -1)"; else check fail binary "missing: $bin"; fi

    # The one number on this machine that only makes sense against another
    # number: today's rate against the one the measurement recorded.
    if [ -n "$MEASURED_HS" ]; then
        local now_rate
        now_rate=$(last_rate)
        case "$now_rate" in
            ''|*[!0-9.]*) now_rate=0 ;;
        esac
        now_rate="${now_rate%%.*}"
        if [ "$now_rate" -gt 0 ] && drift_due "$now_rate" "$MEASURED_HS" "${TUNED_AT:-0}" "$(date +%s)" "$DRIFT_FLOOR" "$DRIFT_MIN_PCT" "0"; then
            check warn hashrate "$now_rate H/s, but this machine measured $MEASURED_HS H/s (it will be measured again)"
        else
            check ok hashrate "${now_rate:-?} H/s (measured $MEASURED_HS H/s)"
        fi
    fi

    if [ -n "$WALLET" ]; then
        # The checksum is verified by the miner, so this line means "a pool can
        # pay this", not "it is the right length".
        if validate_wallet "$WALLET" "$ALGO"; then
            if [ "${WALLET_DECODED:-0}" = 1 ]; then
                check ok wallet "$(wallet_short), checksum verified"
            else
                # No miner to ask: the shape is all this rig can check yet, and
                # saying more would be a claim the tool cannot back.
                check ok wallet "$(wallet_short), shape only (no miner to verify the checksum)"
            fi
        else
            check fail wallet "$(explain_wallet "$WALLET" 2>/dev/null || printf 'invalid for %s' "$ALGO")"
        fi
    else
        check fail wallet "not configured (zmrig-os setup)"
    fi

    check ok topology "$(topology_line)$(mask=$(affinity_mask); [ -n "$mask" ] && printf ', pinned to %s' "$mask")"

    local hw_mem hv
    hw_mem=$(mem_total_mb); [ -n "$hw_mem" ] || hw_mem=0
    hv=$(hw_verdict "$(hw_has avx2)" "$(hw_has aes)" "$hw_mem")
    case "$hv" in
        full)  check ok   compat "$(hw_reason "$hv" "$hw_mem")" ;;
        light|slow) check warn compat "$(hw_reason "$hv" "$hw_mem")" ;;
        *)     check fail compat "$(hw_reason "$hv" "$hw_mem")" ;;
    esac

    # The same arithmetic the initramfs ran before userspace started, so a doctor
    # warning and a boot warning are the same sentence about the same number.
    local cores page_kb
    cores=$(thread_count)
    page_kb=$(awk '/^Hugepagesize:/ { print $2 }' /proc/meminfo 2>/dev/null || echo 2048)
    free_mb=$(mem_total_mb); [ -n "$free_mb" ] || free_mb=0
    need_mb=$(plan_need_mb "$ALGO" "$MODE" "$cores" "$THREADS")
    if [ "$free_mb" -ge "$need_mb" ]; then
        check ok memory "${free_mb} MB total, ${ALGO} needs ${need_mb} MB"
    elif [ "$MODE" = "light" ]; then
        check ok memory "${free_mb} MB total, light mode needs ${need_mb} MB"
    else
        check fail memory "${free_mb} MB total but ${ALGO} needs ${need_mb} MB in this mode: use --mode light or a bigger box"
    fi

    pages_need=$(plan_pages "$ALGO" "$MODE" "$cores" "$free_mb" "$page_kb" "$THREADS" "$HUGEPAGES")
    pages_have=$(awk '/^HugePages_Total:/ { print $2 }' /proc/meminfo 2>/dev/null || echo 0)
    if [ "${HUGEPAGES:-}" = "0" ]; then
        check warn hugepages "reservation disabled (HUGEPAGES=0); the miner runs on THP, which is slower"
    elif [ "${pages_need:-0}" = "0" ]; then
        check warn hugepages "this kernel reports no 2 MB page size"
    elif [ "${pages_have:-0}" -ge "$pages_need" ]; then
        check ok hugepages "${pages_have} x $(( page_kb / 1024 )) MB reserved for ${ALGO}"
    elif [ "${pages_have:-0}" -gt 0 ]; then
        check warn hugepages "${pages_have} of ${pages_need} pages reserved (THP backs the rest; a reserved pool is faster)"
    else
        check warn hugepages "none reserved: the miner runs on THP (~20% slower than a reserved pool)"
    fi

    # 1 GiB pages are never a warning: not having them is not a fault, because
    # the pool has to be reserved before the machine fragments, so it is a
    # decision taken at install time and the miner falls back to 2 MiB pages by
    # itself. What the line must not do is suggest a number the machine cannot
    # afford - it used to advise three pages unconditionally, which on a 4 GB box
    # is advice to reserve 3 GB and leave 1 GB for everything else.
    giga_have=$(cat "$SYS/kernel/mm/hugepages/hugepages-1048576kB/nr_hugepages" 2>/dev/null || echo "")
    giga_worth=$(plan_gigantic_pages "$need_mb" "$free_mb")
    case "${giga_have:-x}" in
        ''|*[!0-9]*) check ok gigantic "no 1 GiB pool on this kernel: the miner uses 2 MiB pages" ;;
        0)
            if [ -n "$giga_worth" ]; then
                check ok gigantic "none reserved; ${giga_worth} x 1 GiB would cover the ${need_mb} MB dataset here (zmrig-os hugepages 1g $giga_worth, next boot)"
            else
                check ok gigantic "none reserved, and ${free_mb} MB is not enough to spare a 1 GiB page here: the miner uses 2 MiB pages"
            fi
            ;;
        *)  check ok gigantic "${giga_have} x 1 GiB reserved: the ${need_mb} MB mapping takes $(( (need_mb + 1023) / 1024 ))" ;;
    esac

    thp=$(cat /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null | sed 's/.*\[\(.*\)\].*/\1/' || echo unknown)
    case "$thp" in
        never) check fail thp "never: ~28% of the hashrate is lost (tune sets madvise)" ;;
        always|madvise) check ok thp "$thp" ;;
        *)     check warn thp "unknown policy: $thp" ;;
    esac

    gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo none)
    case "$gov" in
        performance) check ok governor "$gov" ;;
        none)        check warn governor "no cpufreq driver (fixed-frequency CPU or a VM)" ;;
        *)           check warn governor "$gov: 'zmrig-os tune' sets performance" ;;
    esac

    if msr_usable; then check ok msr "/dev/cpu/0/msr present"; else check warn msr "not applied (VM, or no msr module)"; fi

    # What the miner will actually be allowed to run on.
    if [ -n "${ISOLATED_CPUS:-}" ]; then
        check ok affinity "mining on CPU $(iso_list), kernel on $(housekeeping_list)"
    else
        check ok affinity "no CPUs isolated (zmrig-os isolate N keeps some for mining)"
    fi

    # A sensor the governor cannot read is a safe mode that cannot act. The image
    # has no udev, so this is 'the module was loaded' or nothing.
    sev=$(thermal_now)
    case "$sev" in
        *"no sensor"*) check fail sensor "$sev" ;;
        *)             check ok sensor "hottest CPU reading ${sev}" ;;
    esac

    if is_installed; then
        check ok form "installed on $(media_label), slot $(boot_slot) -> $(read_grubenv zmrig_slot)"
        if [ -x "${OTA_BIN}/current" ]; then
            check ok update "miner from the update channel: $("${OTA_BIN}/current" --version 2>/dev/null | head -1)"
        else
            check ok update "miner from the image"
        fi
    else
        check warn form "live image: the config is in RAM and is lost on reboot (zmrig-os install --disk /dev/sdX)"
    fi

    if [ -e /proc/swaps ] && [ "$(awk 'NR>1' /proc/swaps | wc -l)" -gt 0 ]; then
        check warn swap "swap is active; mining memory should never be swapped"
    else
        check ok swap "off"
    fi

    # DNS is where a pool failure usually starts, and a rig that reports it here
    # is a rig that does not need a site visit.
    host=$(printf '%s' "$POOL" | sed 's|^[a-z]*://||; s|[:/].*||')
    if [ -n "$host" ]; then
        if command -v nslookup >/dev/null 2>&1 && nslookup "$host" >/dev/null 2>&1; then
            check ok dns "$host resolves"
        elif command -v getent >/dev/null 2>&1 && getent hosts "$host" >/dev/null 2>&1; then
            check ok dns "$host resolves"
        else
            check warn dns "$host did not resolve (offline is fine; a rig that never resolves is not)"
        fi
    fi

    if [ -x "$bin" ] && [ -n "$WALLET" ]; then
        # build_args prints one argument per line; splitting them back into
        # words is the whole point of it.
        # shellcheck disable=SC2046
        if out=$("$bin" $(build_args) --check 2>&1); then
            check ok config "miner --check passed"
        else
            check fail config "$(printf '%s' "$out" | tail -1)"
        fi
        fee=$(printf '%s' "$out" 2>/dev/null | grep -a 'donate' | head -1 | sed 's/^ *//')
        [ -n "${fee:-}" ] && check ok fee "$fee"
    fi

    # ---------------------------------------------------------------- security
    # Four things that turn a mining rig into somebody else's machine. None of
    # them is exotic; all of them are one forgotten flag away.

    # 1. The miner's HTTP API. It can restart the miner and read its config;
    #    bound to a LAN address without a token it is an open control port.
    if [ "${API_PORT:-0}" != "0" ]; then
        case "${API_HOST:-127.0.0.1}" in
            127.0.0.1|localhost|::1)
                check ok api "http api on ${API_HOST}:${API_PORT} (loopback only)" ;;
            *)
                if [ -n "${API_TOKEN:-}" ]; then
                    check ok api "http api on ${API_HOST}:${API_PORT} with a token"
                else
                    check fail api "http api on ${API_HOST}:${API_PORT} with NO token: anyone on that network can control the miner"
                fi ;;
        esac
    fi

    # 2. The fleet token is the rig's identity: anyone who reads it can command
    #    this machine. It lives in os.conf, which is 0600 for that reason.
    if [ -n "${FLEET_URL:-}" ]; then
        case "$FLEET_URL" in
            https://*) check ok fleet "${FLEET_URL} (tls)" ;;
            *)         check warn fleet "${FLEET_URL} is not https: the device key travels in clear text" ;;
        esac
    fi

    if [ -f "$CONF" ]; then
        # -rw-r-----  positions 6 and 9 are "group may write" and "anybody may
        # write". Anyone who can rewrite this file chooses where the rig mines.
        case "$(ls -l "$CONF" 2>/dev/null | cut -c1-10)" in
            ??????w???|????????w?)
                check warn perms "$CONF is writable by group or other: whoever can write it chooses the wallet" ;;
            *)
                check ok perms "$CONF is not writable by group or other" ;;
        esac
    fi

    # 3. sshd: keys only, and root may not log in with a password. The image
    #    ships no password for root at all, so this is belt and braces - but a
    #    rig that has been on the end of a USB stick may have been changed.
    if [ -r "$(P /etc/ssh/sshd_config)" ]; then
        if grep -qiE '^[[:space:]]*PermitRootLogin[[:space:]]+yes' "$(P /etc/ssh/sshd_config)" ||
           grep -qiE '^[[:space:]]*PasswordAuthentication[[:space:]]+yes' "$(P /etc/ssh/sshd_config)"; then
            check warn ssh "sshd allows password logins in /etc/ssh/sshd_config"
        else
            check ok ssh "key-only"
        fi
    fi

    # 4. The medium: an installed rig verifies its root filesystem at boot when a
    #    checksum sits next to it, and a rig without one is booting unverified.
    if is_installed; then
        if [ -r "${STATE}/rootfs-$(boot_slot).squashfs.sha256" ]; then
            check ok integrity "slot $(boot_slot) is verified at boot"
        else
            check warn integrity "no checksum next to rootfs-$(boot_slot).squashfs: this slot boots unverified"
        fi
    fi

    if [ "$json" = "1" ]; then
        tally
        printf '{"fail":%d,"warn":%d,"checks":[' "$fails" "$warns"
        first=1
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            st=${line%% *}; rest=${line#* }
            name=${rest%% *}; detail=${rest#* }
            [ "$first" = "1" ] || printf ','
            first=0
            printf '{"status":"%s","check":"%s","detail":"%s"}' \
                "$st" "$(json_escape "$name")" "$(json_escape "$detail")"
        done <<EOF
$REPORT
EOF
        printf ']}\n'
        tally
        [ "$fails" = "0" ]
        return $?
    fi

    printf '\n  %d failed, %d warnings\n' "$fails" "$warns"
    [ "$fails" = "0" ]
}

# --------------------------------------------------------------- installer
#
# Two forms, one image:
#
#   live       boot the stick, mine immediately, nothing is written anywhere.
#              Config, logs and the running binary live in RAM.
#   installed  write the image onto the machine's own disk. Same miner, same
#              modes, same safe governor, but the boot is a normal disk boot
#              (no USB stick to lose), the config survives, and the updater can
#              keep a miner that outlives a reboot.
#
# The install is a copy, not a package manager: an ext4 partition holding the
# kernel, the initramfs and the root squashfs, an EFI partition holding the
# GRUB image, and on BIOS a BIOS-boot partition holding core.img. Everything it
# needs is already on the medium, so it works with no network at all - which is
# the situation on the machine that has no driver for the network.

# Where a file lives on the *running* medium. A live image keeps the kernel next
# to the squashfs on the ISO; an installed one keeps it in /boot with a slot
# suffix. One function, so the updater and the installer cannot disagree.
image_file() { # name -> path or empty
    local name="$1" p
    for p in \
        "${MEDIA}/boot/${name}" \
        "${MEDIA}/boot/${name}-$(boot_slot)" \
        "${MEDIA}/boot/${name}-a" \
        "${MEDIA}/zmrig/${name}" \
        "${MEDIA}/zmrig/${name}-a" \
        "${MEDIA}/zmrig/boot/${name}" \
        "${ROOT}/boot/${name}"; do
        if [ -f "$p" ]; then printf '%s' "$p"; return 0; fi
    done
    return 1
}

esp_uuid_type() { printf '%s' "C12A7328-F81F-11D2-BA4B-00A0C93EC93B"; }
linux_uuid_type() { printf '%s' "0FC63DAF-8483-4772-8E79-3D69D8477DE4"; }
bios_uuid_type() { printf '%s' "21686148-6449-6E6F-744E-656564454649"; }

# The partition table as sfdisk reads it. One definition, used by the dry run and
# by the install itself: a plan that differs from what runs is worse than none.
#
#   1  BIOS boot  1 MiB   core.img lives here on a BIOS machine
#   2  EFI       100 MiB  BOOTX64.EFI, and nothing else
#   3  root      the rest kernel + initramfs + squashfs slot A (and B, later)
partition_script() {
    printf '%s
' \
        "label: gpt" \
        "start=2048, size=2048, type=$(bios_uuid_type), name=\"BIOS boot\"" \
        "start=4096, size=204800, type=$(esp_uuid_type), name=\"EFI\"" \
        "type=$(linux_uuid_type), name=\"ZMRIGROOT\""
}

# What an install copies, printed by --dry-run and executed by a real run.
install_plan() { # disk kernel initramfs squashfs esp_part root_part
    printf '%s\n' \
        "partition   $1: BIOS boot 1 MiB, EFI 100 MiB, root (rest)" \
        "  $(partition_script | tr '\n' '|')" \
        "format      ${5:-<esp>} vfat, label ZMRIGEFI" \
        "format      ${6:-<root>} ext4, label ZMRIGROOT" \
        "install     EFI/BOOT/BOOTX64.EFI on the EFI partition" \
        "copy        $4 -> root/zmrig/rootfs-a.squashfs" \
        "copy        $2 -> root/boot/vmlinuz-a" \
        "copy        $3 -> root/boot/initramfs-a.gz" \
        "write       boot.img -> first 512 bytes of $1, core.img -> sector 2048" \
        "write       root/boot/grub/grub.cfg and grubenv (slot a)"
}

grub_cfg_for() { # rootfs_dir [version]
    local rootfs_mnt="$1" version="${2:-$(image_version)}" slot
    {
        cat <<EOF2
# ZMRIG OS on disk. Written by 'zmrig-os install'; edit the parameters rather
# than the entries, and see 'zmrig-os help' for everything they do.
set timeout=3
set default="a"
if [ -f \${prefix}/grubenv ]; then
    load_env
fi
set default="\${zmrig_slot}"
set zmrig_params="quiet loglevel=3 nowatchdog console=tty0 console=ttyS0,115200"
# Empty unless 'zmrig-os isolate' has written it, and defined here so the
# entries below read the same with or without an environment block.
set zmrig_extra=""
EOF2
        for slot in a b; do
            [ -f "${rootfs_mnt}/zmrig/rootfs-${slot}.squashfs" ] || [ "$slot" = "a" ] || continue
            cat <<EOF2

menuentry "ZMRIG OS ${version} - slot ${slot} - max hashrate" --id "max-${slot}" {
    linux /boot/vmlinuz-${slot} \${zmrig_params} \${zmrig_extra} zmrig.slot=${slot} zmrig.os.mode=max transparent_hugepage=always
    initrd /boot/initramfs-${slot}.gz
}
menuentry "ZMRIG OS ${version} - slot ${slot} - max hashrate, CPU mitigations off" --id "fast-${slot}" {
    linux /boot/vmlinuz-${slot} \${zmrig_params} \${zmrig_extra} zmrig.slot=${slot} zmrig.os.mode=max transparent_hugepage=always mitigations=off
    initrd /boot/initramfs-${slot}.gz
}
menuentry "ZMRIG OS ${version} - slot ${slot} - safe (never above 72 C)" --id "safe-${slot}" {
    linux /boot/vmlinuz-${slot} \${zmrig_params} \${zmrig_extra} zmrig.slot=${slot} zmrig.os.mode=safe zmrig.os.maxtemp=72 transparent_hugepage=madvise
    initrd /boot/initramfs-${slot}.gz
}
menuentry "ZMRIG OS ${version} - slot ${slot} - install to disk" --id "install-${slot}" {
    linux /boot/vmlinuz-${slot} \${zmrig_params} \${zmrig_extra} zmrig.slot=${slot} zmrig.os.nostart=1 transparent_hugepage=madvise
    initrd /boot/initramfs-${slot}.gz
}
menuentry "ZMRIG OS ${version} - slot ${slot} - debug shell" --id "debug-${slot}" {
    linux /boot/vmlinuz-${slot} \${zmrig_params} \${zmrig_extra} zmrig.slot=${slot} zmrig.os.debug=1 zmrig.os.nostart=1 nomodeset
    initrd /boot/initramfs-${slot}.gz
}
EOF2
        done
    }
}

# A fresh environment block for a new install: exactly 1024 bytes, because GRUB
# ignores a block of any other size, and built by the same function the
# initramfs uses so an install and a rollback agree about the format.
grubenv_init() { # path
    local path="$1"
    if command -v plan_grubenv_block >/dev/null 2>&1; then
        plan_grubenv_block zmrig_slot a /dev/null > "$path" 2>/dev/null && return 0
    fi
    awk 'BEGIN {
        head = "# GRUB Environment Block\nzmrig_slot=a\n"
        n = 1023 - length(head)
        pad = ""
        for (i = 0; i < n; i++) pad = pad "#"
        printf "%s%s\n", head, pad
    }' > "$path"
}

cmd_install() {
    local disk="" yes=0 autotune=1 mode="" confirm bytes root_part esp_part install_params
    local kernel initramfs squashfs efi core bootimg rootfs_mnt esp_mnt

    while [ $# -gt 0 ]; do
        case "$1" in
            --disk)      disk="${2:?}"; shift ;;
            --disk=*)    disk="${1#*=}" ;;
            --yes|-y)    yes=1 ;;
            --no-autotune) autotune=0 ;;
            --mode)      mode="${2:?}"; shift ;;
            --mode=*)    mode="${1#*=}" ;;
            --dry-run)   DRYRUN=1 ;;
            *) die "unknown option: $1" ;;
        esac
        shift
    done

    if [ -z "$disk" ]; then
        cat <<EOF2
Two ways to run this image:

  live        boot the stick and mine. Nothing is written to any disk, the
              config lives in RAM, and a reboot forgets it. This is what you
              are running now.

  installed   write the image onto a disk and boot from that. Same miner, same
              modes, but the config survives, the boot is a disk boot, and the
              updater can keep the miner across reboots.

    zmrig-os install --disk /dev/nvme0n1        # or /dev/sda, /dev/vda ...
    zmrig-os install --disk /dev/sda --dry-run  # show the plan, change nothing

The disk is partitioned, not shared: every sector on it is overwritten.
EOF2
        return 0
    fi

    # Argument checks first, privileges second: "that is not a disk" is a better
    # answer than "run as root" when the argument is what is wrong.
    case "$disk" in
        /dev/*) ;;
        *) die "not a device path: $disk (expected /dev/sdX, /dev/nvme0n1, /dev/vda)" ;;
    esac
    case "$disk" in
        /dev/loop*|/dev/sr*) die "refusing to install onto $disk" ;;
    esac
    [ -b "$disk" ] || die "$disk is not a block device"

    is_root || die "run as root (partitioning and formatting need it)"

    # Writing the disk this machine booted from destroys the running system.
    if [ -r "$(P /etc/zmrig/bootdev)" ]; then
        local bootdev
        bootdev=$(cat "$(P /etc/zmrig/bootdev)")
        case "$bootdev" in
            "$disk"|"${disk}"[0-9]*) die "$disk is the disk this system booted from" ;;
        esac
        # A partition of the target holding our own medium is the same disk.
        case "$bootdev" in
            "${disk}"p[0-9]*) die "$disk is the disk this system booted from" ;;
        esac
    fi

    if grep -q " $disk" /proc/mounts 2>/dev/null; then
        die "$disk has a mounted partition; unmount it first"
    fi

    bytes=$(blockdev --getsize64 "$disk" 2>/dev/null || echo 0)
    [ "${bytes:-0}" -ge $((2 * 1024 * 1024 * 1024)) ] ||
        die "$disk is smaller than 2 GB; the image needs about 1.5 GB"

    # Everything the install copies has to be here before the target is wiped:
    # discovering a missing kernel halfway through is how a machine becomes a
    # brick and a support ticket at the same time.
    kernel=$(image_file vmlinuz) || die "no kernel on the medium (is this a ZMRIG OS image?)"
    # `.zst` on an image whose kernel config said it can unpack zstd, `.gz`
    # everywhere else. The kernel decides by the archive's magic bytes, so this
    # only has to find the file.
    initramfs=$(image_file initramfs.zst) || initramfs=$(image_file initramfs.gz) || \
        initramfs=$(image_file initramfs) || die "no initramfs on the medium"
    squashfs=$(image_file rootfs.squashfs) || squashfs=$(image_file rootfs-a.squashfs) || die "no rootfs.squashfs on the medium"
    efi=$(image_file BOOTX64.EFI) || efi=$(image_file bootx64.efi) || die "no BOOTX64.EFI on the medium (rebuild the image)"
    core=$(image_file core.img) || die "no core.img on the medium (rebuild the image)"
    bootimg=$(image_file boot.img) || die "no boot.img on the medium (rebuild the image)"
    for tool in sfdisk mkfs.vfat mkfs.ext4; do
        command -v "$tool" >/dev/null || die "$tool is missing from this image"
    done

    # Keep the wallet the machine is already mining with; a fresh install that
    # asks for it again is not "automatic".
    load_conf
    [ -n "$mode" ] && MODE="$mode"

    say "target    $disk ($(blockdev --getsize64 "$disk" 2>/dev/null | awk '{printf "%.1f GB", $1/1073741824}'))"
    if [ -n "$WALLET" ]; then
        say "wallet    $(wallet_short) (kept)"
    else
        say "wallet    (none yet: the wizard asks on the first boot, or pass zmrig.os.wallet=)"
    fi
    say "layout    BIOS boot 1 MiB | EFI 100 MiB | ZMRIGROOT ext4 (rest)"
    say "boot      slot a, 5 failed boots roll back to slot b"

    if [ "$yes" != "1" ]; then
        if [ -t 0 ]; then
            printf '\nEverything on %s will be destroyed. Type "yes" to continue: ' "$disk"
            read -r confirm
            [ "$confirm" = "yes" ] || die "cancelled"
        else
            die "refusing to wipe $disk without --yes (it is not a terminal)"
        fi
    fi

    # Partition names differ between kernels: /dev/sda3 vs /dev/nvme0n1p3.
    case "$disk" in
        *[0-9]) root_part="${disk}p3"; esp_part="${disk}p2" ;;
        *)      root_part="${disk}3"; esp_part="${disk}2" ;;
    esac

    if [ "$DRYRUN" = "1" ]; then
        say ""
        say "plan:"
        install_plan "$disk" "$kernel" "$initramfs" "$squashfs" "$esp_part" "$root_part" | sed 's/^/  /'
        say ""
        say "dry run: nothing was changed."
        return 0
    fi

    # ---- partition
    say "partitioning $disk"
    run wipefs -a "$disk" >/dev/null 2>&1 || true
    partition_script |
        run sfdisk --wipe always --wipe-partitions always --no-tell-kernel "$disk" >/dev/null ||
        die "sfdisk failed"

    run partprobe "$disk" >/dev/null 2>&1 || true
    sleep 1
    [ -b "$root_part" ] || die "the kernel did not create $root_part"

    # ---- filesystems
    say "formatting"
    run mkfs.vfat -F32 -n ZMRIGEFI "$esp_part" >/dev/null || die "mkfs.vfat failed"
    run mkfs.ext4 -q -F -L ZMRIGROOT -m 1 "$root_part" || die "mkfs.ext4 failed"

    esp_mnt="${ROOT}/mnt/esp"
    rootfs_mnt="${ROOT}/mnt/root"
    run mkdir -p "$esp_mnt" "$rootfs_mnt"
    run mount "$esp_part" "$esp_mnt" || die "cannot mount $esp_part"
    run mount "$root_part" "$rootfs_mnt" || die "cannot mount $root_part"

    # ---- EFI: the standalone GRUB image only, because it carries its modules
    # and finds its config by label (see the early config in build-iso.sh).
    say "installing the EFI bootloader"
    run mkdir -p "${esp_mnt}/EFI/BOOT"
    run cp "$efi" "${esp_mnt}/EFI/BOOT/BOOTX64.EFI" || die "cannot copy the EFI image"

    # ---- the root filesystem
    say "copying the miner (this is the slow part, about a minute)"
    run mkdir -p "${rootfs_mnt}/boot/grub" "${rootfs_mnt}/zmrig" "${rootfs_mnt}/etc/zmrig" \
                 "${rootfs_mnt}/zmrig/bin" "${rootfs_mnt}/zmrig/state"
    run cp "$kernel"    "${rootfs_mnt}/boot/vmlinuz-a"        || die "cannot copy the kernel"
    run cp "$initramfs" "${rootfs_mnt}/boot/initramfs-a.gz"   || die "cannot copy the initramfs"
    run cp "$squashfs"  "${rootfs_mnt}/zmrig/rootfs-a.squashfs" || die "cannot copy the root filesystem"
    # The checksum the initramfs checks before it mounts this slot. It has to be
    # written from what was actually copied, not from the source file: a copy
    # that went wrong is exactly what this is for.
    slot_sha=$(sha256sum "${rootfs_mnt}/zmrig/rootfs-a.squashfs" 2>/dev/null | cut -d' ' -f1)
    if [ -n "$slot_sha" ]; then
        printf '%s\n' "$slot_sha" > "${rootfs_mnt}/zmrig/rootfs-a.squashfs.sha256"
    else
        warn "could not checksum the installed root filesystem; it will boot unverified"
    fi
    run cp "$bootimg"   "${rootfs_mnt}/boot/boot.img"         2>/dev/null || true
    run cp "$core"      "${rootfs_mnt}/boot/core.img"         2>/dev/null || true
    # The bootloader images travel with the install, so this machine can flash
    # or repair another one without a network.
    run mkdir -p "${rootfs_mnt}/zmrig/boot"
    run cp "$efi"  "${rootfs_mnt}/zmrig/boot/BOOTX64.EFI" 2>/dev/null || true
    run cp "$core" "${rootfs_mnt}/zmrig/boot/core.img"    2>/dev/null || true
    run cp "$bootimg" "${rootfs_mnt}/zmrig/boot/boot.img" 2>/dev/null || true

    printf '%s\n' "$(image_version)" > "${rootfs_mnt}/zmrig/version" 2>/dev/null || true
    : > "${rootfs_mnt}/zmrig/installed"

# The menu an installed rig boots with. Two slots, chosen by the environment
# block, with the same choices a live image has. Slot B appears only once an
# update writes it, so a fresh install cannot boot a root filesystem that does
# not exist.
#
# ${zmrig_extra} is the line that makes `zmrig-os isolate N` mean something:
# isolcpus / nohz_full / rcu_nocbs are parsed before the scheduler exists, so the
# tool can only write them into the environment block and let the next boot pick
# them up. Without this reference the parameters were written, reported as "next
# boot: isolcpus=4-7", and silently ignored, which is a rig that looks isolated
# and mines on every core.
    run mkdir -p "${rootfs_mnt}/boot/grub"
    grub_cfg_for "$rootfs_mnt" > "${rootfs_mnt}/boot/grub/grub.cfg"

    # 1024 bytes: GRUB ignores an environment block of any other size.
    grubenv_init "${rootfs_mnt}/boot/grub/grubenv"

    # The kernel parameters go with the install. A fresh block starts empty, and
    # a rig whose live stick had `isolate 4` or a 1 GiB page reservation lost
    # both at the moment it was installed - silently, because the tool that
    # wrote them was on the stick and the block was on the disk.
    install_params=$(boot_params_value)
    if [ -n "$install_params" ]; then
        if grubenv_set "${rootfs_mnt}/boot/grub/grubenv" zmrig_extra "$install_params"; then
            say "boot      $install_params"
        else
            warn "could not write the kernel parameters into the installed boot block; add these by hand:"
            say "  $install_params"
        fi
    fi

    # The config the installed system boots with: the same wallet, pool and
    # mode, plus the marker that makes /etc/zmrig persistent.
    mkdir -p "${rootfs_mnt}/etc/zmrig"
    conf_to_media "${rootfs_mnt}/etc/zmrig/os.conf"

    run sync
    run umount "$esp_mnt" || die "cannot unmount $esp_mnt"
    run umount "$rootfs_mnt" || die "cannot unmount $rootfs_mnt"

    # ---- BIOS: boot.img in the MBR, core.img at the start of partition 1
    say "installing the BIOS bootloader"
    run dd if="$bootimg" of="$disk" bs=440 count=1 conv=notrunc status=none ||
        die "cannot write the MBR"
    run dd if="$core" of="$disk" bs=512 seek=2048 conv=notrunc status=none ||
        die "cannot write core.img"

    # ---- verify, from the disk rather than from the copy we think we made
    say "verifying"
    run sync
    local want got
    want=$(sha256sum "$squashfs" | cut -d' ' -f1)
    # Read back through a fresh mount: a hash of the file we just copied proves
    # the copy, not the disk.
    run mkdir -p "$rootfs_mnt"
    run mount -o ro "$root_part" "$rootfs_mnt" || die "the new filesystem cannot be mounted"
    got=$(sha256sum "${rootfs_mnt}/zmrig/rootfs-a.squashfs" | cut -d' ' -f1)
    run umount "$rootfs_mnt"
    [ "$want" = "$got" ] || die "the root filesystem on disk does not match the one on the medium"
    say "sha256    matches ($(printf '%s' "$got" | cut -c1-16)...)"

    # ---- measure this machine while we are on it
    if [ "$autotune" = "1" ] && [ -x "$(zmrig_bin)" ]; then
        say "measuring the thread count (about 30 s; --no-autotune skips it)"
        if THREADS=$(autotune_threads); then
            say "threads   $THREADS (pinned for the installed system)"
            # Write it into the installed config, not the live one.
            run mkdir -p "$rootfs_mnt"
            if run mount "$root_part" "$rootfs_mnt"; then
                sed -i "s/^THREADS=.*/THREADS=\"$THREADS\"/" "${rootfs_mnt}/etc/zmrig/os.conf" 2>/dev/null || true
                run sync
                run umount "$rootfs_mnt"
            fi
        else
            warn "autotune did not produce a thread count; the heuristic stays"
        fi
    fi

    say ""
    say "done. Remove the stick and boot from $disk."
    say "  the miner starts on its own, updates itself daily, and rolls back to"
    say "  the other slot if an update will not boot."
}

# Writes the current configuration to a path, in the same format load_conf reads.
conf_to_media() { # path
    local out="$1"
    mkdir -p "$(dirname "$out")" 2>/dev/null || true

    {
        cat <<EOF
# ZMRIG OS configuration. Written by \`zmrig-os\`; the initramfs reads this file
# on every boot, so it is the one that survives.
EOF
        conf_body
    } > "$out"
}

# The thread search, shared by `zmrig-os autotune` and the installer, because
# an install that ends with "now measure it yourself" is not automatic.
autotune_threads() {
    local bin args out best
    bin=$(zmrig_bin)
    [ -x "$bin" ] || return 1
    args=$(build_args 2>/dev/null) || return 1
    args=$(printf '%s' "$args" | sed 's/ -t [0-9]*//; s/ --health-restart [0-9]*//; s/ --print-time [0-9]*//; s| --log-file [^ ]*||')
    # shellcheck disable=SC2086
    out=$("$bin" $args --autotune=8 2>&1) || return 1
    best=$(printf '%s\n' "$out" | sed -n 's/^autotune-best-threads=\([0-9]*\)$/\1/p' | tail -1)
    [ -n "$best" ] || return 1
    printf '%s' "$best"
}

# --------------------------------------------------------------- updater

fetch() { # url -> stdout
    local url="$1"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --max-time 30 "$url"
    else
        wget -q -T 30 -O - "$url"
    fi
}

# The image was compiled for one instruction level, and a binary built for
# x86-64-v3 faults on a v2 CPU. The updater therefore asks for the manifest that
# matches this image, not for a generic one.
image_arch() {
    local a=""
    [ -r "$ETC/arch" ] && a=$(cat "$ETC/arch" 2>/dev/null || true)
    printf '%s' "${a:-x86-64-v3}"
}

manifest_url() {
    if [ -n "$MANIFEST_OVERRIDE" ]; then
        printf '%s' "$MANIFEST_OVERRIDE"
        return 0
    fi
    local base="$MANIFEST_URL"
    [ "$CHANNEL" = "beta" ] && base="$MANIFEST_BETA_URL"
    printf '%s/zmrig-os-%s-%s.json' "$base" "$CHANNEL" "$(image_arch)"
}

version_gt() { newer_than "$1" "$2"; }

manifest_field() { # json key
    grep -o "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | sed 's/.*:[[:space:]]*"//; s/"$//' | head -1
}

cmd_update() {
    local mode="check" target="" write="" manifest latest current tmp url sha

    while [ $# -gt 0 ]; do
        case "$1" in
            --check)  mode="check" ;;
            --apply)  mode="apply" ;;
            --binary) mode="binary" ;;
            --iso)    mode="iso" ;;
            --write)  write="${2:?}"; shift ;;
            --write=*) write="${1#*=}" ;;
            --channel) CHANNEL="${2:?}"; shift ;;
            --channel=*) CHANNEL="${1#*=}" ;;
            *) die "unknown option: $1" ;;
        esac
        shift
    done

    load_conf
    CHANNEL=${CHANNEL:-stable}

    manifest=$(fetch "$(manifest_url)") ||
        die "no $CHANNEL manifest at $(manifest_url); an unreachable server and a release that was never published look the same from here"
    latest=$(printf '%s' "$manifest" | manifest_field version)
    [ -n "$latest" ] || die "the update manifest is not readable"

    current=$(image_version)
    say "installed  $current"
    say "available  $latest ($CHANNEL)"

    if [ "$mode" = "check" ]; then
        if version_gt "$latest" "$current"; then say "run 'zmrig-os update --apply' to install it"; fi
        return 0
    fi

    case "$mode" in
        binary|apply)
            url=$(printf '%s' "$manifest" | manifest_field binary_url)
            sha=$(printf '%s' "$manifest" | manifest_field binary_sha256)
            [ -n "$url" ] || die "the manifest has no binary for this channel"
            tmp="${RUN}/zmrig.new"
            mkdir -p "$RUN"
            say "downloading $url"
            fetch "$url" > "$tmp" || die "download failed"
            # A manifest with no checksum cannot be verified, and the manual
            # path used to accept that while the unattended one refused it -
            # the same download, a weaker rule because a person was watching.
            # The person watching is the one who cannot tell a truncated
            # download or a captive-portal page from a binary.
            [ -n "$sha" ] || die "the manifest has no binary_sha256: refusing to install something it cannot verify"
            verify_sha "$tmp" "$sha" || die "checksum mismatch: refusing to install"
            chmod +x "$tmp"
            # Same install path as the automatic one: on an installed disk the
            # binary goes next to the running system so it survives a reboot,
            # on a live image it lands in RAM and says so.
            ota_install_binary "$tmp" "$latest" || die "the binary could not be installed"
            if running; then cmd_restart; fi
            ;;
    esac

    if [ "$mode" = "iso" ] || [ -n "$write" ]; then
        [ -n "$write" ] || die "--write /dev/sdX is required to flash an image"
        url=$(printf '%s' "$manifest" | manifest_field iso_url)
        sha=$(printf '%s' "$manifest" | manifest_field iso_sha256)
        target="${ROOT}/var/tmp/zmrig-os.iso"
        mkdir -p "$(dirname "$target")"
        say "downloading $url"
        fetch "$url" > "$target" || die "download failed"
        [ -n "$sha" ] || die "the manifest has no iso_sha256: refusing to write an image it cannot verify"
        verify_sha "$target" "$sha" || die "checksum mismatch: refusing to write"

        # Writing the stick you booted from turns a running rig into a brick.
        case "$write" in
            /dev/sr*|/dev/loop*) die "refusing to write to $write" ;;
        esac
        if [ -r "$ETC/bootdev" ] && [ "$(cat "$ETC/bootdev")" = "$write" ]; then
            die "refusing to overwrite the device this machine booted from"
        fi

        say "writing $target to $write (this destroys it)"
        run dd if="$target" of="$write" bs=4M status=none conv=fsync
        run sync
        say "done: reboot from $write"
    fi
}

# ---------------------------------------------------------------- automatic
#
# A rig on a wall does not get visited. `zmrig-os auto --once` is what the daily
# timer runs: check the manifest, install a newer miner, and - when the operator
# asked for it - write the whole image into the other slot and switch to it.
#
# The binary update is the common one and it is trivial to undo: a symlink.
# The image update is the rare one and it is not: it writes a second root
# filesystem next to the running one, verifies it, points the next boot at it,
# and leaves the old one alone. The initramfs counts failed boots, so an image
# that does not come back up is rolled back without anybody driving anywhere.

# One place that decides "is A newer than B", used by the updater, the status
# line and the installer's verification.
newer_than() { # a b -> 0 when a is newer
    [ "$1" = "$2" ] && return 1
    [ "$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)" = "$1" ]
}

# Installs a binary next to the running system's, then moves `current` to it in
# one rename. The old file stays until the next update, so `zmrig-os auto
# --rollback` works even after the new one has failed.
ota_install_binary() { # source_path version
    local src="$1" ver="$2" dest
    if ! is_installed; then
        # A live image has nowhere to persist it. Install it into the running
        # system anyway - a rig that stays up for months benefits - and say so.
        say "live image: the update lasts until the next reboot"
        run mv "$src" "$(P /usr/local/bin/zmrig)"
        return 0
    fi

    dest="${OTA_BIN}/zmrig-${ver}"
    run mkdir -p "$OTA_BIN"
    run cp "$src" "$dest" || return 1
    run chmod 755 "$dest"
    # Keep the previous one as `previous`, if there is one.
    if [ -x "${OTA_BIN}/current" ]; then
        run cp "$(readlink -f "${OTA_BIN}/current" 2>/dev/null || echo "${OTA_BIN}/current")" \
               "${OTA_BIN}/previous" 2>/dev/null || true
    fi
    run ln -sfn "zmrig-${ver}" "${OTA_BIN}/current" || return 1
    say "installed $dest"
    return 0
}

# Copies one root filesystem, one kernel and one initramfs into the free slot,
# verifies them, and points the next boot at it.
ota_write_slot() { # iso_path version
    local iso="$1" ver="$2" slot mnt tmp img
    slot=$(other_slot "$(boot_slot)")

    [ -f "${STATE}/installed" ] || { warn "image updates need an installed disk (zmrig-os install)"; return 1; }
    [ -n "$(image_file core.img)" ] || { warn "this image has no bootloader files; rebuild it"; return 1; }

    # The new slot is written under a temporary name: a power cut in the middle
    # of the copy must not leave a half file that GRUB is willing to boot.
    mnt="${ROOT}/mnt/update"
    run mkdir -p "$mnt"
    run mount -o ro,loop "$iso" "$mnt" || { warn "cannot mount the downloaded image"; return 1; }

    tmp="${STATE}/rootfs-${slot}.new"
    say "writing slot ${slot}"
    if ! run cp "${mnt}/zmrig/rootfs.squashfs" "$tmp"; then
        warn "cannot copy the root filesystem"
        run umount "$mnt"
        return 1
    fi
    run cp "${mnt}/boot/vmlinuz" "${MEDIA}/boot/vmlinuz-${slot}.new" 2>/dev/null || true
    for src in "${mnt}/boot/initramfs.zst" "${mnt}/boot/initramfs.gz"; do
        [ -f "$src" ] || continue
        run cp "$src" "${MEDIA}/boot/initramfs-${slot}.new" 2>/dev/null || true
        break
    done
    run umount "$mnt"

    # Verify what is on the medium, then rename all three into place.
    img=$(sha256sum "$tmp" | cut -d' ' -f1)
    say "sha256    ${img%%????????????????*}"
    printf '%s\n' "$img" > "${STATE}/rootfs-${slot}.squashfs.sha256.new" 2>/dev/null || true
    run mv "$tmp" "${STATE}/rootfs-${slot}.squashfs" || return 1
    run mv "${STATE}/rootfs-${slot}.squashfs.sha256.new" "${STATE}/rootfs-${slot}.squashfs.sha256" 2>/dev/null || true
    [ -f "${MEDIA}/boot/vmlinuz-${slot}.new" ] &&
        run mv "${MEDIA}/boot/vmlinuz-${slot}.new" "${MEDIA}/boot/vmlinuz-${slot}"
    [ -f "${MEDIA}/boot/initramfs-${slot}.new" ] &&
        run mv "${MEDIA}/boot/initramfs-${slot}.new" "${MEDIA}/boot/initramfs-${slot}.gz"

    printf '%s\n' "$ver" > "${STATE}/slot-${slot}.version" 2>/dev/null || true
    set_next_slot "$slot" || return 1
    run sync
    return 0
}

cmd_auto() {
    local check=0 image=0 manifest latest current url sha tmp
    local auto_update auto_image

    while [ $# -gt 0 ]; do
        case "$1" in
            --once)      : ;;   # the only mode: run once and exit
            --check)     check=1 ;;
            --image)     image=1 ;;
            --apply)     : ;;   # the default when a newer version exists
            *) die "unknown option: $1" ;;
        esac
        shift
    done

    load_conf
    auto_update=$(conf_default AUTO_UPDATE "1")
    auto_image=$(conf_default AUTO_IMAGE "0")

    [ "$auto_update" = "1" ] || [ "$check" = "1" ] || [ "$image" = "1" ] ||
        { say "automatic updates are off (AUTO_UPDATE=0 in $CONF)"; return 0; }

    manifest=$(fetch "$(manifest_url)") || {
        # No network is normal on a rig behind a firewall, and it is not a
        # failure worth waking anybody for: say it once and exit 0.
        say "cannot reach the update server for the $CHANNEL channel (offline is fine; the miner keeps running)"
        return 0
    }
    latest=$(printf '%s' "$manifest" | manifest_field version)
    [ -n "$latest" ] || { warn "the update manifest is not readable"; return 1; }

    current=$(image_version)
    say "installed  $current"
    say "available  $latest ($CHANNEL)"

    if ! newer_than "$latest" "$current"; then
        say "up to date"
        [ "$image" = "1" ] && return 0
        return 0
    fi

    [ "$check" = "1" ] && { say "run 'zmrig-os auto --apply' to install it"; return 0; }

    # ---- the miner binary
    url=$(printf '%s' "$manifest" | manifest_field binary_url)
    sha=$(printf '%s' "$manifest" | manifest_field binary_sha256)
    if [ -n "$url" ]; then
        tmp="${RUN}/zmrig.new"
        run mkdir -p "$RUN"
        say "downloading $url"
        if fetch "$url" > "$tmp"; then
            if [ -z "$sha" ]; then
                warn "the manifest has no checksum for the miner: refusing an update that cannot be verified"
                rm -f "$tmp"
            elif verify_sha_required "$tmp" "$sha"; then
                ota_install_binary "$tmp" "$latest" || warn "the binary could not be installed"
                if running; then cmd_restart; fi
            else
                warn "checksum mismatch: refusing to install the miner"
                rm -f "$tmp"
            fi
        else
            warn "the miner download failed"
        fi
    fi

    # ---- the image, in the other slot
    if [ "$auto_image" = "1" ] || [ "$image" = "1" ]; then
        url=$(printf '%s' "$manifest" | manifest_field iso_url)
        sha=$(printf '%s' "$manifest" | manifest_field iso_sha256)
        if [ -n "$url" ]; then
            local iso="${STATE}/update.iso"
            run mkdir -p "$STATE"
            say "downloading $url"
            if fetch "$url" > "$iso"; then
                if [ -z "$sha" ]; then
                    warn "the manifest has no checksum for the image: refusing to write an unverified slot"
                    rm -f "$iso"
                elif verify_sha_required "$iso" "$sha"; then
                    if ota_write_slot "$iso" "$latest"; then
                        rm -f "$iso"
                        say "the next boot runs $latest; 'zmrig-os slot $(boot_slot)' undoes it"
                        if [ "${AUTO_REBOOT:-1}" = "1" ] && is_root; then
                            say "rebooting in 60 s (AUTO_REBOOT=0 stops this)"
                            run sync
                            run shutdown -r +1 "ZMRIG OS update to $latest" 2>/dev/null ||
                                run reboot
                        fi
                    fi
                else
                    warn "checksum mismatch: refusing to write the image"
                    rm -f "$iso"
                fi
            else
                warn "the image download failed"
            fi
        fi
    fi
    return 0
}

cmd_slot() {
    local want="${1:-}"
    if [ -z "$want" ]; then
        printf '%-14s %s\n' "running" "$(boot_slot)"
        printf '%-14s %s\n' "next boot" "$(read_grubenv zmrig_slot)"
        for slot in a b; do
            [ -f "${STATE}/rootfs-${slot}.squashfs" ] || continue
            printf '%-14s %s\n' "slot $slot" \
                "$( [ -f "${STATE}/slot-${slot}.version" ] && cat "${STATE}/slot-${slot}.version" || image_version )"
        done
        return 0
    fi

    case "$want" in a|b) ;; *) die "usage: zmrig-os slot [a|b]" ;; esac
    [ -f "${STATE}/rootfs-${want}.squashfs" ] || die "slot $want is empty"
    is_installed || die "slot switching needs an installed disk"
    set_next_slot "$want"
    say "reboot to use it"
}

verify_sha() { # file expected
    local file="$1" expected="$2" actual
    [ -n "$expected" ] || return 0
    actual=$(sha256sum "$file" | cut -d' ' -f1)
    [ "$actual" = "$expected" ]
}

# The same check for an update nobody is watching. A manifest with no checksum
# cannot be verified, and the failure it lets through is the quiet one: a
# truncated download, a captive-portal HTML page saved under the binary's name, a
# redirect to a mirror that served the wrong file. Staying one version behind is
# always better than installing that and restarting the miner into it.
verify_sha_required() { # file expected
    [ -n "${2:-}" ] || return 1
    verify_sha "$1" "$2"
}

# --------------------------------------------------------------- helpers

cmd_persist() {
    local device="${1:-}"
    [ -n "$device" ] || die "usage: zmrig-os persist /dev/sdX1"
    is_root || die "run as root"
    case "$device" in /dev/*) ;; *) die "not a device path: $device" ;; esac

    load_conf
    say "formatting $device as ext4, label ZMRIGDATA"
    run mkfs.ext4 -q -L ZMRIGDATA "$device" || die "mkfs failed (is it mounted?)"

    local mnt="${ROOT}/mnt/persist"
    run mkdir -p "$mnt"
    run mount "$device" "$mnt" || die "mount failed"
    run mkdir -p "${mnt}/etc/zmrig"
    run cp "$CONF" "${mnt}/etc/zmrig/os.conf" 2>/dev/null || true
    run umount "$mnt"
    say "config copied; the image will mount it at /etc/zmrig on the next boot"
}

cmd_ssh_key() {
    # sshd reads /root/.ssh/authorized_keys, not a file of our invention.
    local action="${1:-list}" key_dir="${ROOT}/root/.ssh" key_file="${ROOT}/root/.ssh/authorized_keys"

    case "$action" in
        add)
            mkdir -p "$key_dir"
            if [ -t 0 ]; then
                say "paste the public key (ssh-ed25519 AAAA... comment), then Enter:"
                read -r key
            else
                read -r key
            fi
            case "$key" in
                ssh-*|ecdsa-*) ;;
                *) die "that does not look like a public key" ;;
            esac
            printf '%s\n' "$key" >> "$key_file"
            chmod 600 "$key_file"
            say "added; 'rc-service sshd start' enables the server"
            ;;
        list)
            [ -f "$key_file" ] && cat "$key_file" || say "no keys configured"
            ;;
        *) die "usage: zmrig-os ssh-key add|list" ;;
    esac
}

cmd_export() {
    load_conf
    cat "$CONF"
}

# --------------------------------------------------------------------- fleet
#
# A rig in a fleet is configured from a chat window, not from a keyboard on the
# rig. The protocol is deliberately one-way at the HTTP level: the machine calls
# out, never listens, so a rig behind NAT or on a mobile link works, and nothing
# on the internet can reach into it.
#
#   zmrig-os id                  the Device ID + enrolment code, off the console
#   zmrig-os fleet --url URL     where the control plane lives
#   zmrig-os sync                check in: send state, apply what was queued
#
# The key in <state>/device.key is the identity. It is generated on the machine,
# never leaves it, and the Device ID and the enrolment code are both derived from
# it - which is why a person has to be able to see the machine to enrol it, and
# why a leaked Device ID is worth nothing on its own.

DEVICE_KEY="device.key"
ACKFILE="${RUN}/acks"
# Nothing here is allowed to hold the miner up. These are the same numbers the
# fleet server documents.
FLEET_TIMEOUT_CONNECT="5"
FLEET_TIMEOUT_TOTAL="25"

# Where the key can live. On an installed disk the boot medium, because that is
# the only writable thing that survives a reboot; on a live stick the tmpfs, and
# `zmrig-os id` says so, because a rig that changes identity after a power cut is
# a rig that cannot be enrolled from a chat window.
fleet_dir() {
    local dir

    # An installed rig keeps the key next to the root filesystem on its own
    # disk. A live stick keeps it in /etc/zmrig, which is RAM unless somebody
    # ran `zmrig-os persist` - and then it is the stick, without this script
    # having to know the difference.
    if is_installed && [ -n "$STATE" ] && mkdir -p "$STATE" 2>/dev/null && [ -w "$STATE" ]; then
        printf '%s' "$STATE"
        return 0
    fi

    for dir in "$ETC" "$RUN"; do
        [ -n "$dir" ] || continue
        mkdir -p "$dir" 2>/dev/null || true
        if [ -d "$dir" ] && [ -w "$dir" ]; then
            printf '%s' "$dir"
            return 0
        fi
    done
    printf '%s' "$RUN"
}

device_secret() {
    local dir file secret
    dir=$(fleet_dir)
    file="${dir}/${DEVICE_KEY}"
    if [ -s "$file" ]; then
        secret=$(tr -cd '0-9a-f' < "$file" 2>/dev/null || true)
        if [ "${#secret}" -eq 64 ]; then
            printf '%s' "$secret"
            return 0
        fi
        # A half-written key is a key that will collide with nothing and
        # authenticate nowhere, so keep it and make a new one.
        mv "$file" "${file}.damaged" 2>/dev/null || true
        warn "the device key was damaged; a new identity is being made"
    fi

    mkdir -p "$dir" 2>/dev/null || true
    if ! ( umask 077; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$file" ) || [ ! -s "$file" ]; then
        warn "cannot write ${file}"
        return 1
    fi
    chmod 600 "$file" 2>/dev/null || true
    tr -cd '0-9a-f' < "$file"
}

# ZMR-XXXX-XXXX-XXXX: the first six bytes of sha256(key), upper-case hex. The
# server recomputes this from the key it is shown, so an ID can never be claimed
# by a machine that does not hold the key behind it.
device_id() {
    local secret hex
    secret=$(device_secret) || return 1
    hex=$(printf '%s' "$secret" | sha256sum 2>/dev/null | cut -c1-12 | tr 'a-f' 'A-F')
    [ "${#hex}" -eq 12 ] || return 1
    printf 'ZMR-%s-%s-%s' "$(printf '%s' "$hex" | cut -c1-4)" \
        "$(printf '%s' "$hex" | cut -c5-8)" "$(printf '%s' "$hex" | cut -c9-12)"
}

# sha256("enroll:" + key), first four bytes. Typing this proves the machine is
# in front of you; it is not a password and it stops working when the key does.
enrol_code() {
    local secret hex
    secret=$(device_secret) || return 1
    hex=$(printf 'enroll:%s' "$secret" | sha256sum 2>/dev/null | cut -c1-8 | tr 'a-f' 'A-F')
    [ "${#hex}" -eq 8 ] || return 1
    printf '%s-%s' "$(printf '%s' "$hex" | cut -c1-4)" "$(printf '%s' "$hex" | cut -c5-8)"
}

fleet_url() { printf '%s' "${FLEET_URL:-}"; }

# One JSON string field, without a JSON library. `.*` is greedy on purpose: the
# key is unique inside a command object, so the last match is the right one.
# One string, safe inside a JSON document: backslash, quote and the control
# characters that would otherwise end the line or the document early.
json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\t\r' '  ' | tr -d '\000-\010\013\014\016-\037'
}

json_field() {
    sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1
}

json_number() {
    sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -1
}

# Values that go into the body are restricted to what the protocol uses; a pool
# named `$(reboot)` is not a pool.
safe_value() { tr -cd 'A-Za-z0-9.:/@_+-' | cut -c1-200; }

log_payload() {
    if [ -f "${RUN}/wantlog" ] && [ -f "$LOG" ]; then
        printf '"%s"' "$(tail -n 30 "$LOG" 2>/dev/null | tr -d '\r' | tr -cd '[:print:]\n' |
            sed 's/\\/\\\\/g; s/"/\\"/g' | awk 'BEGIN { ORS = "\\n" } { print }')"
    else
        printf 'null'
    fi
}

acks_payload() {
    local out="" id ok cmd detail
    [ -f "$ACKFILE" ] || { printf '[]'; return 0; }
    while IFS='|' read -r id ok cmd detail; do
        [ -n "$id" ] || continue
        out="${out}${out:+,}{\"id\":\"${id}\",\"cmd\":\"${cmd}\",\"ok\":${ok},\"detail\":\"${detail}\"}"
    done < "$ACKFILE"
    printf '[%s]' "$out"
}

ack_add() { # id ok cmd detail
    local id ok cmd detail
    id=$(printf '%s' "$1" | tr -cd 'A-Za-z0-9' | cut -c1-32)
    ok="$2"
    cmd=$(printf '%s' "$3" | tr -cd 'A-Za-z0-9._-' | cut -c1-32)
    detail=$(printf '%s' "$4" | tr -cd 'A-Za-z0-9 ._:-' | cut -c1-120)
    mkdir -p "$RUN" 2>/dev/null || true
    printf '%s|%s|%s|%s\n' "$id" "$ok" "$cmd" "$detail" >> "$ACKFILE"
}

fleet_body() {
    local state rate temp up installed=false slot coin threads reason log
    load_conf

    if running; then
        state="mining"
    else
        state="stopped"
    fi
    reason=""
    [ -z "$WALLET" ] && reason="no wallet configured"
    # The miner refuses to start under rx/0 on an address that fails its
    # checksum, so "stopped" without a reason would send whoever reads the
    # dashboard looking at the network. The reason is the wallet: this is the
    # same verdict `doctor` prints, reduced to the characters a status field
    # can carry.
    if [ -z "$reason" ] && [ -n "$WALLET" ] && ! validate_wallet "$WALLET" "$ALGO"; then
        reason="wallet address is not valid: $(explain_wallet "$WALLET" 2>/dev/null || printf 'wrong shape')"
        reason=$(printf '%s' "$reason" | tr -c 'A-Za-z0-9.:/@_+ -' ' ' | cut -c1-160)
    fi

    rate=$(last_rate)
    case "$rate" in ''|*[!0-9.]*) rate=0 ;; esac
    # The rate the last measurement recorded, so the control plane can tell
    # "this rig is slow today" from "this rig is half what it measured" without
    # keeping state of its own.
    measured="$MEASURED_HS"
    case "$measured" in ''|*[!0-9]*) measured=0 ;; esac
    temp=$(thermal_c 2>/dev/null || true)
    case "$temp" in ''|*[!0-9]*) temp=0 ;; esac
    up=$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)
    case "$up" in ''|*[!0-9]*) up=0 ;; esac
    if is_installed; then installed=true; else installed=false; fi
    slot=""
    if is_installed; then slot=$(boot_slot) || slot="a"; fi

    case "$ALGO" in
        auto|"") coin="xmr" ;;
        rx/wow)  coin="wow" ;;
        rx/arq)  coin="arq" ;;
        rx/graft) coin="graft" ;;
        rx/sfx)  coin="sfx" ;;
        rx/yada) coin="yada" ;;
        panthera) coin="xla" ;;
        *) coin="$ALGO" ;;
    esac

    threads="${THREADS:-auto}"
    log=$(log_payload)

    cat <<EOF
{"device":"$(device_id 2>/dev/null || echo unknown)","version":"$(image_version)","status":{"state":"$state","reason":"$reason","hashrate":${rate:-0},"measured":${measured:-0},"temp":${temp:-0},"uptime":${up:-0},"mode":"$(printf '%s' "$MODE" | safe_value)","wallet":"$(printf '%s' "$WALLET" | safe_value)","pool":"$(printf '%s' "$POOL" | safe_value)","worker":"$(printf '%s' "$WORKER" | safe_value)","coin":"$(printf '%s' "$coin" | safe_value)","threads":"$threads","maxtemp":"${SAFE_TEMP:-}","version":"$(image_version)","slot":"$slot","installed":$installed},"acks":$(acks_payload),"log":$log}
EOF
}

# Returns 0 on success. The answer is on stdout; a rig that is offline prints
# nothing and is not a failure worth stopping for.
fleet_post() { # url body
    local url="$1" body="$2" secret id
    id=$(device_id) || return 1
    secret=$(device_secret) || return 1

    if command -v curl >/dev/null 2>&1; then
        curl -fsS --connect-timeout "$FLEET_TIMEOUT_CONNECT" --max-time "$FLEET_TIMEOUT_TOTAL" \
            -H 'content-type: application/json' \
            -H "authorization: Bearer ${secret}" \
            -H "x-zmrig-device: ${id}" \
            --data-binary "$body" "$url"
    elif command -v wget >/dev/null 2>&1; then
        wget -q -T "$FLEET_TIMEOUT_TOTAL" -O - \
            --header='content-type: application/json' \
            --header="authorization: Bearer ${secret}" \
            --header="x-zmrig-device: ${id}" \
            --post-data="$body" "$url"
    else
        warn "no curl and no wget: cannot reach the fleet"
        return 1
    fi
}

# Applies the settings half of a queued command. Sets SETUP_CHANGED when the
# miner's command line would change, and SETUP_DETAIL when something is refused.
apply_setup() { # json line
    local line="$1" value

    value=$(printf '%s' "$line" | json_field wallet)
    if [ -n "$value" ]; then
        validate_wallet "$value" "$ALGO" || { SETUP_DETAIL="wallet rejected"; return 1; }
        [ "$value" = "$WALLET" ] || SETUP_CHANGED=1
        WALLET="$value"
    fi

    value=$(printf '%s' "$line" | json_field pool)
    if [ -n "$value" ]; then
        case "$value" in
            *[!A-Za-z0-9.:/@_-]*) SETUP_DETAIL="pool rejected"; return 1 ;;
        esac
        case "$value" in
            *:*) ;;
            *) SETUP_DETAIL="pool needs host:port"; return 1 ;;
        esac
        [ "$value" = "$POOL" ] || SETUP_CHANGED=1
        POOL="$value"
    fi

    value=$(printf '%s' "$line" | json_field coin)
    if [ -n "$value" ]; then
        case "$value" in
            xmr)      value="auto" ;;
            wow)      value="rx/wow" ;;
            arq)      value="rx/arq" ;;
            graft)    value="rx/graft" ;;
            sfx)      value="rx/sfx" ;;
            yada)     value="rx/yada" ;;
            xla)      value="panthera" ;;
            *)        SETUP_DETAIL="unknown coin"; return 1 ;;
        esac
        [ "$value" = "$ALGO" ] || SETUP_CHANGED=1
        ALGO="$value"
    fi

    value=$(printf '%s' "$line" | json_field mode)
    if [ -n "$value" ]; then
        case "$value" in
            max|balanced|eco|light|safe) ;;
            *) SETUP_DETAIL="unknown mode"; return 1 ;;
        esac
        [ "$value" = "$MODE" ] || SETUP_CHANGED=1
        MODE="$value"
    fi

    value=$(printf '%s' "$line" | json_field maxtemp)
    if [ -n "$value" ]; then
        case "$value" in
            *[!0-9]*) SETUP_DETAIL="temperature rejected"; return 1 ;;
        esac
        if [ "$value" -lt 50 ] || [ "$value" -gt 95 ]; then
            SETUP_DETAIL="temperature outside 50-95"
            return 1
        fi
        [ "$value" = "$SAFE_TEMP" ] || SETUP_CHANGED=1
        SAFE_TEMP="$value"
    fi

    value=$(printf '%s' "$line" | json_field threads)
    if [ -n "$value" ]; then
        case "$value" in
            auto) ;;
            *[!0-9]*) SETUP_DETAIL="threads rejected"; return 1 ;;
            *) if [ "$value" -lt 1 ] || [ "$value" -gt 199 ]; then SETUP_DETAIL="threads out of range"; return 1; fi ;;
        esac
        [ "$value" = "$THREADS" ] || SETUP_CHANGED=1
        THREADS="$value"
    fi

    value=$(printf '%s' "$line" | json_field worker)
    if [ -n "$value" ]; then
        case "$value" in
            *[!A-Za-z0-9._-]*) SETUP_DETAIL="worker name rejected"; return 1 ;;
        esac
        [ "$value" = "$WORKER" ] || SETUP_CHANGED=1
        WORKER="$value"
    fi

    if [ "$SETUP_CHANGED" = 1 ]; then
        save_conf
    fi
    return 0
}

apply_command() { # one command object
    local line="$1" cid cmd ok=1 detail=""

    cid=$(printf '%s' "$line" | json_field id)
    cmd=$(printf '%s' "$line" | json_field cmd)
    [ -n "$cid" ] || return 0

    case "$cmd" in
        setup)
            SETUP_CHANGED=0
            SETUP_DETAIL=""
            if apply_setup "$line"; then
                detail="applied"
                if [ "$SETUP_CHANGED" = 1 ] && running; then
                    cmd_restart >/dev/null 2>&1 || true
                    detail="applied, miner restarted"
                fi
            else
                ok=0
                detail="${SETUP_DETAIL:-rejected}"
            fi
            ;;
        start)
            if running; then detail="already mining"
            elif cmd_start >/dev/null 2>&1; then detail="started"
            else ok=0; detail="start failed"; fi
            ;;
        stop)
            cmd_stop >/dev/null 2>&1 || true
            detail="stopped; the machine is still reachable"
            ;;
        restart)
            if cmd_restart >/dev/null 2>&1; then detail="restarted"
            else ok=0; detail="restart failed"; fi
            ;;
        update)
            if cmd_auto --once >/dev/null 2>&1; then detail="update checked and applied"
            else ok=0; detail="update failed"; fi
            ;;
        log)
            mkdir -p "$RUN" 2>/dev/null || true
            : > "${RUN}/wantlog"
            detail="log with the next check-in"
            ;;
        reboot)
            REBOOT_AFTER=1
            detail="rebooting"
            ;;
        *)
            ok=0
            detail="unknown command"
            ;;
    esac

    if [ "$ok" = 1 ]; then ack_add "$cid" true "$cmd" "$detail"; else ack_add "$cid" false "$cmd" "$detail"; fi
    log_os "fleet: $cmd ${detail}"
}

cmd_device() {
    local id code url seen=""
    load_conf
    id=$(device_id) || die "cannot create a device key"
    code=$(enrol_code) || die "cannot derive the enrolment code"
    url=$(fleet_url)

    printf 'ZMRIG OS %s\n\n' "$(image_version)"
    printf '  %-11s %s\n' "device" "$id"
    printf '  %-11s %s\n' "enrol code" "$code"
    printf '  %-11s %s\n' "fleet" "${url:-not set (zmrig-os fleet --url https://...)}"

    if [ -f "${RUN}/sync.last" ]; then
        seen=$(cut -d' ' -f1 "${RUN}/sync.last" 2>/dev/null || true)
        case "$seen" in
            ''|*[!0-9]*) seen="" ;;
            *) printf '  %-11s %s s ago, revision %s\n' "checked in" "$(( $(date +%s) - seen ))" \
                   "$(cut -d' ' -f2 "${RUN}/sync.last" 2>/dev/null || echo 0)" ;;
        esac
    fi
    [ -n "$seen" ] || printf '  %-11s %s\n' "checked in" "never"

    if ! is_installed; then
        printf '\n  This key lives in RAM: the rig gets a new ID after a reboot.\n'
        printf '  Install to disk (zmrig-os install --disk /dev/sdX) or keep the config\n'
        printf '  on a USB stick (zmrig-os persist /dev/sdX1) to make it permanent.\n'
    fi

    printf '\n  In the bot:  /enroll %s %s rig-1\n' "$id" "$code"
}

cmd_fleet() {
    local url=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --url) url="${2:?}" ; shift ;;
            --url=*) url="${1#*=}" ;;
            "") ;;
            *) die "usage: zmrig-os fleet --url https://host" ;;
        esac
        shift
    done

    load_conf
    if [ -n "$url" ] && [ "$url" != "-" ]; then
        case "$url" in
            https://*|http://*) ;;
            *) die "the fleet URL must start with https:// (or http:// on a LAN)" ;;
        esac
        FLEET_URL="$url"
        save_conf
        say "fleet set to $FLEET_URL"
        return 0
    fi

    if [ -n "$url" ]; then
        FLEET_URL=""
        save_conf
        say "fleet disabled"
        return 0
    fi

    printf '%-14s %s\n' "device" "$(device_id 2>/dev/null || echo '?')"
    printf '%-14s %s\n' "enrol code" "$(enrol_code 2>/dev/null || echo '?')"
    printf '%-14s %s\n' "server" "$(fleet_url)"
    printf '%-14s %s s\n' "interval" "${FLEET_INTERVAL:-$FLEET_INTERVAL_DEFAULT}"
    if [ -f "${RUN}/sync.last" ]; then
        printf '%-14s %s s ago\n' "last check-in" "$(( $(date +%s) - $(cut -d' ' -f1 "${RUN}/sync.last") ))"
    fi
}

# The check-in lock, and what to do when its owner is gone.
#
# A lock left behind is a rig that never checks in again until somebody reboots
# it. There are two ways to leave one: the OOM killer (or any SIGKILL) takes the
# agent between `mkdir` and its trap, and a power cut lands in the same window.
# `/run` is tmpfs, so the directory outlives the process that made it and there
# is nothing on the other side to notice.
sync_take_lock() {
    if mkdir "${RUN}/sync.lock" 2>/dev/null; then
        printf '%s\n' "$$" >"${RUN}/sync.lock/pid" 2>/dev/null || true
        return 0
    fi

    local owner age now
    owner=$(cat "${RUN}/sync.lock/pid" 2>/dev/null || true)
    case "$owner" in ''|*[!0-9]*) owner="" ;; esac

    now=$(date +%s)
    age=$(stat -c %Y "${RUN}/sync.lock" 2>/dev/null || true)
    case "$age" in ''|*[!0-9]*) age="$now" ;; esac

    # Longer than any check-in can take: the request is bounded by --max-time,
    # and five minutes is already three times the longest configured one. The
    # age check is also what protects against a reused PID, which is how a dead
    # owner can look alive.
    if [ $((now - age)) -lt 300 ]; then
        [ -n "$owner" ] || return 1
        kill -0 "$owner" 2>/dev/null && return 1
    fi

    printf 'fleet: taking over a stale check-in lock (pid %s, %s s old)\n' \
        "${owner:-unknown}" "$((now - age))" >>"$OSLOG" 2>/dev/null || true
    rm -rf "${RUN}/sync.lock"
    mkdir "${RUN}/sync.lock" 2>/dev/null || return 1
    printf '%s\n' "$$" >"${RUN}/sync.lock/pid" 2>/dev/null || true
    return 0
}

cmd_sync() {
    local quiet=0 force=0 url resp interval cmds line count=0
    local next="" now=""
    REBOOT_AFTER=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) quiet=1 ;;
            --now|--force) force=1 ;;
            *) die "usage: zmrig-os sync [--now] [--quiet]" ;;
        esac
        shift
    done

    load_conf
    url=$(fleet_url)
    if [ -z "$url" ]; then
        [ "$quiet" = 1 ] || say "no fleet server configured (zmrig-os fleet --url https://...)"
        return 0
    fi

    mkdir -p "$RUN" 2>/dev/null || true

    # One check-in at a time. Two crons, a boot script and an impatient operator
    # must not become two hellos and two applications of the same command.
    if ! sync_take_lock; then
        return 0
    fi
    # `rm -rf`, not `rmdir`: the lock holds the owner's pid, and rmdir on a
    # non-empty directory would leave the lock behind for ever - the very
    # failure this lock is now careful to recover from.
    trap 'rm -rf "${RUN}/sync.lock" 2>/dev/null || true' EXIT HUP INT TERM

    if [ "$force" = 0 ] && [ -f "${RUN}/sync.next" ]; then
        next=$(cat "${RUN}/sync.next" 2>/dev/null || echo 0)
        now=$(date +%s)
        case "$next" in ''|*[!0-9]*) next=0 ;; esac
        if [ "$now" -lt "$next" ]; then
            return 0
        fi
    fi

    if ! resp=$(fleet_post "${url%/}/v1/hello" "$(fleet_body)" 2>/dev/null); then
        [ "$quiet" = 1 ] || say "cannot reach ${url} (offline is fine; mining continues)"
        return 0
    fi
    : > "$ACKFILE"

    interval=$(printf '%s' "$resp" | json_number interval)
    case "$interval" in ''|*[!0-9]*) interval="${FLEET_INTERVAL:-$FLEET_INTERVAL_DEFAULT}" ;; esac
    if [ "$interval" -lt 15 ]; then interval=15; fi
    printf '%s' "$(( $(date +%s) + interval ))" > "${RUN}/sync.next"
    printf '%s %s\n' "$(date +%s)" "$(printf '%s' "$resp" | json_number config_version)" > "${RUN}/sync.last"

    cmds=$(printf '%s' "$resp" | sed -n 's/.*"commands":\[\(.*\)\].*/\1/p')
    if [ -n "$cmds" ]; then
        # The trailing newline is not cosmetic: `read` returns false on a last
        # line without one, which would silently drop every command.
        printf '%s\n' "$(printf '%s' "$cmds" | sed 's/},{/}\n{/g')" > "${RUN}/commands"
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            count=$((count + 1))
            apply_command "$line"
        done < "${RUN}/commands"
        rm -f "${RUN}/commands"
    fi

    if [ "$count" -gt 0 ] && [ "$quiet" = 0 ]; then
        say "applied $count command(s) from $url"
    fi

    # A reboot has to be reported before it happens, or the chat never learns
    # that its instruction was carried out: one more hello, with the ack in it.
    if [ "$REBOOT_AFTER" = 1 ]; then
        fleet_post "${url%/}/v1/hello" "$(fleet_body)" >/dev/null 2>&1 || true
        : > "$ACKFILE"
        log_os "fleet: rebooting as instructed"
        run sync
        run reboot
    fi
    return 0
}

cmd_version() {
    printf 'ZMRIG OS %s\n' "$(image_version)"
    # The base, from the image itself: see os/build-iso.sh.
    if [ -r "$(P /etc/zmrig/base)" ]; then
        while read -r key value; do
            [ -n "$key" ] && printf '  %-9s %s\n' "$key" "$value"
        done < "$(P /etc/zmrig/base)"
    fi
    if [ -x "$(zmrig_bin)" ]; then "$(zmrig_bin)" --version 2>/dev/null | head -1; fi
}

# The usage text *is* the header of this file: one copy, so a new command cannot
# be documented in one place and forgotten in the other.
usage() {
    sed -n '3,/^# Environment/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
}

main() {
    local cmd="${1:-status}"
    [ $# -gt 0 ] && shift

    case "$cmd" in
        setup)    cmd_setup "$@" ;;
        mode)     cmd_mode "$@" ;;
        isolate)  cmd_isolate "$@" ;;
        hugepages|huge) cmd_hugepages "$@" ;;
        quickstart|quick) cmd_quickstart "$@" ;;
        boot)     cmd_boot "$@" ;;
        tune)     cmd_tune "$@" ;;
        start)    cmd_start "$@" ;;
        stop)     cmd_stop "$@" ;;
        restart)  cmd_restart "$@" ;;
        run)      supervise "$@" ;;
        args)     cmd_args "$@" ;;
        status)   cmd_status "$@" ;;
        logs)     cmd_logs "$@" ;;
        bench)    cmd_bench "$@" ;;
        doctor)   cmd_doctor "$@" ;;
        autotune) cmd_autotune "$@" ;;
        topology) cmd_topology "$@" ;;
        hardware|hw) cmd_hardware ;;
        install)  cmd_install "$@" ;;
        auto)     cmd_auto "$@" ;;
        slot)     cmd_slot "$@" ;;
        update)   cmd_update "$@" ;;
        persist)  cmd_persist "$@" ;;
        ssh-key)  cmd_ssh_key "$@" ;;
        export)   cmd_export "$@" ;;
        id|device-id) cmd_device "$@" ;;
        fleet)    cmd_fleet "$@" ;;
        sync)     cmd_sync "$@" ;;
        version|-V|--version) cmd_version ;;
        help|-h|--help) usage ;;
        *) die "unknown command: $cmd (try 'zmrig-os help')" ;;
    esac
}

# The memory and CPU arithmetic, shared with the initramfs so `doctor`, `tune`
# and the boot cannot disagree about how many pages this machine needs.
for _plan in "${ROOT}/usr/local/lib/zmrig/plan.sh" /plan.sh; do
    [ -r "$_plan" ] || continue
    # The path depends on how the image was laid out, which is the point.
    # shellcheck source=/dev/null
    . "$_plan"
    break
done
unset _plan

# A damaged image must still answer `doctor` and `status`: these keep the two
# numbers meaningful when plan.sh is missing, and `doctor` reports the missing
# file instead of the tool dying halfway down the list.
PLAN_MISSING=""
if ! command -v plan_pages >/dev/null 2>&1; then
    PLAN_MISSING="1"
    plan_cache_mb() { printf '%s' 256; }
    plan_dataset_mb() { printf '%s' 2080; }
    plan_threads() { printf '%s' "$2"; }
    plan_need_mb() { printf '%s' 2336; }
    plan_pages() {
        case "${5:-0}" in ''|0|*[!0-9]*) printf '%s' 0 ;; *) printf '%s' "$(( (2336 * 1024 + $5 - 1) / $5 ))" ;; esac
    }
    # No plan, no advice: a damaged image cannot work out whether this machine
    # could afford a 1 GiB page, and guessing would send an operator to a boot
    # parameter that does not fit.
    plan_gigantic_pages() { printf '%s' ''; }
    plan_mask_hex() { return 1; }
    plan_iso_cpus() { return 0; }
    plan_housekeeping() { return 0; }
    plan_join_list() { printf '%s' "$*" | tr ' ' ','; }
fi

# The test suite sources this file to assert the pure decisions (the partition
# table, the plan, the version comparison) without running a command.
[ -n "${ZMRIG_OS_NO_MAIN:-}" ] || main "$@"
