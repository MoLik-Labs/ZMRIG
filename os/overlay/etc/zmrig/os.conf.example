# Copy to /etc/zmrig/os.conf, or run `zmrig-os setup`, which writes this file.
#
# On a live stick the image is read-only, so this file lives on the tmpfs overlay
# and is lost on reboot unless a ZMRIGDATA partition exists
# (`zmrig-os persist /dev/sdX1`) or the values came from the kernel command line
# (zmrig.os.wallet=4...). On an installed disk (`zmrig-os install --disk ...`)
# the copy on the boot medium is read back at every boot and this file simply
# persists.
WALLET=""
POOL="gulf.moneroocean.stream:10001"
WORKER="rig"
MODE="max"
ALGO="auto"
THREADS="auto"
# The developer fee, in percent of Monero mining time. Three by default, and it
# is a setting, not a rule: 0 turns it off, 1 to 10 are all accepted, and
# `zmrig-os doctor` prints the value this machine will actually run with.
DONATE="3"

# The RandomX MSR preset: prefetchers off, worth 5-15 % on bare metal and nothing
# in a virtual machine. auto = the miner decides (it knows whether this CPU has a
# preset and whether /dev/cpu/0/msr answers), on = always ask, off = never open
# /dev/cpu. `safe` mode never writes these registers whatever this says.
MSR="auto"
API_PORT="0"
API_HOST="127.0.0.1"
API_TOKEN=""
AUTO_REBOOT="1"
# The miner is updated daily: the new binary is written next to the running
# system, and the previous one is kept so the upgrade can be undone.
AUTO_UPDATE="1"
# Also update the OS image itself (kernel + root filesystem). It goes into the
# other A/B slot and only becomes the default once the copy has been verified;
# three failed boots on a slot roll the machine back to the other one.
AUTO_IMAGE="0"
CHANNEL="stable"
# Huge pages: empty means "size the pool from ALGO" (2.3 GB for Monero, 192 MB
# for Scala), 0 turns the reservation off. The initramfs reads this before it
# reserves, so a light-mode box does not ask for pages it cannot use.
HUGEPAGES=""
# 1 GiB pages, as a count to reserve at boot. Empty (or 0) means none, and the
# miner then reads its dataset through 2 MiB pages, which is what almost every
# rig does and is far better than 4 KiB. A gigantic pool is worth it for one
# reason only: a Monero dataset is 1 040 TLB entries at 2 MiB and two at 1 GiB.
# It cannot be created after the machine has fragmented, so it is a kernel
# parameter, not a sysctl: `zmrig-os hugepages 1g 3` writes it and the next boot
# reserves it. The pool is reserved whether or not the miner ends up using it, so
# a 4 GiB rig that never mines Monero should leave this empty.
HUGEPAGES_1G=""
# Logical CPUs kept for mining, as whole SMT cores (0 = shared with the OS).
# `zmrig-os isolate 4` writes this and the matching kernel parameters; the kernel
# side (isolcpus, nohz_full, rcu_nocbs) takes effect on the next boot.
ISOLATE="0"
EXTRA_ARGS=""
# The control plane (Telegram and/or Discord bot). Empty means no fleet: nothing
# on the rig contacts anything until a server is named here or on the kernel
# command line (`zmrig.os.fleet=https://...`).
FLEET_URL=""
# How often the rig checks in, in seconds. The server may lower this further.
FLEET_INTERVAL="60"
