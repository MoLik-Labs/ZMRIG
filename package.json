{
  "name": "zmrig",
  "version": "6.48.0",
  "description": "ZMRIG - RandomX miner with a 3% developer fee that is printed and switchable off, by @nggkhaiz",
  "main": "index.js",
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "build": "node scripts/generate_cl.js",
    "test": "node run_tests.js",
    "test:web": "node --test legacy/tests/*.test.js",
    "test:pool": "node --test pool/tests/*.test.js",
    "test:thermal": "bash zmrig/tests/thermal.sh",
    "test:switch": "bash zmrig/tests/switch.sh",
    "test:duty": "bash zmrig/tests/duty.sh",
    "test:targets": "bash zmrig/tests/targets.sh",
    "test:oneclick": "bash tests/oneclick/plan.sh && bash tests/oneclick/config.sh && bash tests/oneclick/governor.sh && bash tests/oneclick/tune-targets.sh && bash tests/oneclick/light-fallback.sh && bash tests/oneclick/purge.sh",
    "test:releases": "bash tests/releases/latest-iso.test.sh && bash tests/releases/version-consistency.test.sh",
    "test:serve": "cd serve && npm test",
    "test:host": "node --test host/tests/*.test.js",
    "test:docs": "bash tests/docs/links.sh && bash tests/docs/pages.sh && bash tests/docs/identity.sh && bash tests/docs/setup-page.sh",
    "test:pages": "bash tests/docs/pages.sh",
    "build:site": "cd site && npm run build",
    "publish:site": "bash scripts/publish-site.sh",
    "test:site": "cd site && npm test",
    "test:identity": "bash tests/docs/identity.sh",
    "bench:host": "node host/bench.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoLik-Labs/ZMRIG.git"
  },
  "keywords": [
    "monero",
    "randomx",
    "miner",
    "pool",
    "zig",
    "gpl-3.0"
  ],
  "author": "@nggkhaiz (https://github.com/NggKhaiz)",
  "license": "GPLv3",
  "bugs": {
    "url": "https://github.com/MoLik-Labs/ZMRIG/issues"
  },
  "homepage": "https://molik-labs.github.io/ZMRIG/",
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
